{% comment %}
  Section contract.
  ellura-callout renders a narrow information callout with an icon, heading and supporting text
  (reference "ellura supports urinary tract health. It is not a treatment.").
  @example
  <!-- How it works page, above the references drawer -->
{% endcomment %}
<div class="section section--tight" id="callout-{{ section.id }}">
  <div class="wrap wrap--narrow">
    <div class="callout" data-fade>
      {% render 'ellura-icon', name: section.settings.icon, px: 28 %}
      <div class="stack-sm">
        {%- if section.settings.heading != blank -%}
          <h2 class="t-h4">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        <div class="muted">{{ section.settings.text }}</div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Callout",
  "tag": "section",
  "class": "section-ellura-callout",
  "settings": [
    { "type": "select", "id": "icon", "label": "Icon", "options": [{"value": "capsule", "label": "Capsule"}, {"value": "drop", "label": "Drop"}, {"value": "leaf", "label": "Leaf"}, {"value": "wheat", "label": "Wheat"}, {"value": "dna", "label": "Dna"}, {"value": "cube", "label": "Cube"}, {"value": "flask", "label": "Flask"}, {"value": "shield", "label": "Shield"}, {"value": "check", "label": "Check"}, {"value": "info", "label": "Info"}, {"value": "bolt", "label": "Bolt"}, {"value": "repeat", "label": "Repeat"}, {"value": "pause", "label": "Pause"}, {"value": "truck", "label": "Truck"}, {"value": "box", "label": "Box"}, {"value": "bag", "label": "Bag"}, {"value": "store", "label": "Store"}, {"value": "gift", "label": "Gift"}, {"value": "pin", "label": "Pin"}, {"value": "mail", "label": "Mail"}, {"value": "phone", "label": "Phone"}, {"value": "chat", "label": "Chat"}, {"value": "lock", "label": "Lock"}, {"value": "user", "label": "User"}, {"value": "star", "label": "Star"}, {"value": "search", "label": "Search"}, {"value": "arrow", "label": "Arrow"}], "default": "info" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "ellura supports urinary tract health. It is not a treatment." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>ellura is not intended to diagnose, treat, cure or prevent any disease, and it cannot replace antibiotics for an active infection.</p>" }
  ],
  "presets": [{ "name": "Callout", "category": "ellura" }]
}
{% endschema %}

          "type": "point",
          "settings": {
            "point_number": "03",
            "text": "<p>Clinical research shows that only supplements with the highest levels of soluble PACs, like ellura, deliver powerful urinary tract defence.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}

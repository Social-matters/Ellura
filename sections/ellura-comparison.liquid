{% comment %}
  Section contract:
  ellura-comparison renders the "Why it's different" section:
  Left: Key clinical points (3 bullet points) + visual source comparison (Juice vs Pomace) + CTA button
  Right: Interactive Anti-adhesion Activity scientific chart with animated bars and capsule
  Powered by GSAP scroll triggers and full Theme Editor customization.
{% endcomment %}

<div
  id="comparison-{{ section.id }}"
  class="diff-section"
  style="--diff-bg: {{ section.settings.bg_color }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  {{ section.shopify_attributes }}
>
  <div class="diff" style="background: var(--diff-bg);">
    <div class="wrap diff__grid">
      <!-- Left Copy Column -->
      <div class="diff__copy">
        {% if section.settings.eyebrow != blank %}
          <p class="eyebrow" data-gsap="fade-up">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}

        <h2 id="diff-title-{{ section.id }}" class="t-d2 accent-em" data-gsap="fade-up">
          {{ section.settings.heading }}
        </h2>

        <ul class="diff__points" role="list" data-gsap="stagger">
          {% for block in section.blocks %}
            {% if block.type == 'point' %}
              <li {{ block.shopify_attributes }}>
                <span class="diff__n t-mono">{{ block.settings.point_number | escape }}</span>
                <p>{{ block.settings.text }}</p>
              </li>
            {% endif %}
          {% endfor %}
        </ul>

        <!-- Visual Source Comparison (Juice vs Pomace) -->
        <div class="diff__sources" data-gsap="fade-up">
          <figure class="diff__source">
            <div class="diff__source-img">
              {% if section.settings.juice_img != blank %}
                <img src="{{ section.settings.juice_img | image_url: width: 600 }}" alt="Cranberry Juice" width="300" height="200" loading="lazy">
              {% else %}
                <img src="{{ 'cranberry-cut-800.webp' | asset_url }}" alt="Cranberry Juice" width="300" height="200" loading="lazy">
              {% endif %}
            </div>
            <figcaption>
              <strong>{{ section.settings.juice_title | default: 'Juice' }}</strong>
              <span>{{ section.settings.juice_desc | default: 'Soluble PACs — free to be absorbed' }}</span>
            </figcaption>
          </figure>

          <figure class="diff__source diff__source--pomace">
            <div class="diff__source-img">
              {% if section.settings.pomace_img != blank %}
                <img src="{{ section.settings.pomace_img | image_url: width: 600 }}" alt="Cranberry Pomace" width="300" height="200" loading="lazy">
              {% else %}
                <img src="{{ 'berries-dark-800.webp' | asset_url }}" alt="Cranberry Pomace" width="300" height="200" loading="lazy">
              {% endif %}
            </div>
            <figcaption>
              <strong>{{ section.settings.pomace_title | default: 'Pomace' }}</strong>
              <span>{{ section.settings.pomace_desc | default: 'Insoluble PACs — trapped in fibre' }}</span>
            </figcaption>
          </figure>
        </div>

        {% if section.settings.btn_text != blank %}
          <a href="{{ section.settings.btn_link | default: '/collections/all' }}" class="btn" data-gsap="fade-up">
            {{ section.settings.btn_text | escape }}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        {% endif %}
      </div>

      <!-- Right Scientific Activity Chart Column -->
      <div class="diff__chart-wrap">
        <figure class="chart" id="chart-{{ section.id }}">
          <figcaption class="sr-only">
            Chart of urinary anti-adhesion activity. ellura, with 36 mg of soluble, bioactive A-type PACs from 100% concentrated cranberry fruit juice extract powder, reaches 100%. Other cranberry products sit below 50%.
          </figcaption>

          <div class="chart__plot" aria-hidden="true">
            <p class="chart__axis-title t-mono">{{ section.settings.chart_axis | default: 'Anti-adhesion activity %' }}</p>

            <div class="chart__levels">
              <div class="chart__level" style="bottom: 100%;">
                <span class="t-mono">100%</span>
                <i class="chart__gridline"></i>
              </div>
              <div class="chart__level" style="bottom: 55%;">
                <span class="t-mono">&lt;50%</span>
                <i class="chart__gridline"></i>
              </div>
              <div class="chart__level" style="bottom: 26%;">
                <span class="t-mono">Inferior</span>
                <i class="chart__gridline"></i>
              </div>
              <div class="chart__level" style="bottom: 6%;">
                <span class="t-mono">Inactive (0%)</span>
                <i class="chart__gridline"></i>
              </div>
            </div>

            <div class="chart__cols">
              <!-- Ellura Column -->
              <div class="chart__col">
                <div class="chart__bar chart__bar--ellura" style="height: 94%;">
                  <span class="chart__brand">ellura</span>
                  <span class="chart__txt">Soluble, bioactive A-type PACs from 100% concentrated cranberry fruit juice extract powder (Gikacran®)</span>
                  <svg class="chart__capsule" viewBox="0 0 40 90" aria-hidden="true">
                    <rect x="4" y="4" width="32" height="82" rx="16" />
                    <path d="M4 45h32" />
                  </svg>
                </div>
                <p class="chart__x">36 mg PACs</p>
              </div>

              <!-- Other Products Column -->
              <div class="chart__col">
                <div class="chart__bar chart__bar--other" style="height: 49%;">
                  <span class="chart__txt">Other cranberry products</span>
                </div>
                <div class="chart__bar chart__bar--pomace" style="height: 20%;">
                  <span class="chart__txt">Insoluble PACs from pomace*</span>
                </div>
                <p class="chart__x">&lt;36 mg PACs</p>
              </div>
            </div>
          </div>

          <p class="claim chart__note">{{ section.settings.chart_note | default: '*Insoluble PACs from pomace remain trapped in fibre and have negligible anti-adhesion effect.' }}</p>
        </figure>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    function initChartGSAP() {
      var chart = document.getElementById('chart-{{ section.id }}');
      if (!chart) return;

      function playChartAnimation() {
        if (chart.dataset.animated === 'true') return;
        chart.dataset.animated = 'true';

        if (typeof gsap === 'undefined') return;

        var tl = gsap.timeline({ defaults: { ease: 'expo.out' } });
        tl.fromTo(chart.querySelectorAll('.chart__gridline'),
          { scaleX: 0 },
          { scaleX: 1, duration: 0.9, stagger: 0.08, ease: 'power3.inOut', transformOrigin: 'left' }
        )
        .fromTo(chart.querySelector('.chart__bar--ellura'),
          { scaleY: 0 },
          { scaleY: 1, duration: 1.4, ease: 'expo.out', transformOrigin: 'bottom' },
          0.3
        )
        .fromTo(chart.querySelector('.chart__bar--other'),
          { scaleY: 0 },
          { scaleY: 1, duration: 1.1, ease: 'expo.out', transformOrigin: 'bottom' },
          0.55
        )
        .fromTo(chart.querySelector('.chart__bar--pomace'),
          { scaleY: 0 },
          { scaleY: 1, duration: 1.0, ease: 'expo.out', transformOrigin: 'bottom' },
          0.7
        )
        .fromTo(chart.querySelectorAll('.chart__txt'),
          { opacity: 0, y: 10 },
          { opacity: 1, y: 0, stagger: 0.1, duration: 0.6 },
          0.9
        )
        .fromTo(chart.querySelector('.chart__capsule'),
          { opacity: 0, rotate: -40, y: -30 },
          { opacity: 1, rotate: -28, y: 0, duration: 1, ease: 'back.out(1.6)' },
          1.0
        );
      }

      if (typeof ScrollTrigger !== 'undefined') {
        ScrollTrigger.create({
          trigger: chart,
          start: 'top 85%',
          once: true,
          onEnter: playChartAnimation
        });
      }

      if ('IntersectionObserver' in window) {
        var observer = new IntersectionObserver(function (entries) {
          if (entries[0].isIntersecting) {
            playChartAnimation();
            observer.disconnect();
          }
        }, { threshold: 0.2 });
        observer.observe(chart);
      }

      // Check if already in viewport
      var rect = chart.getBoundingClientRect();
      if (rect.top < window.innerHeight * 0.9 && rect.bottom > 0) {
        playChartAnimation();
      }

      window.addEventListener('load', function () {
        if (typeof ScrollTrigger !== 'undefined') ScrollTrigger.refresh();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initChartGSAP);
    } else {
      initChartGSAP();
    }

    document.addEventListener('shopify:section:load', function (e) {
      if (e.target.id === 'shopify-section-{{ section.id }}') {
        initChartGSAP();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Why Ellura Is Different",
  "tag": "section",
  "class": "section-ellura-comparison",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Why it’s different"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "how is <span class='brand-word'>ellura</span> <em>different?</em>"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Card background color",
      "default": "#ead3ee"
    },
    {
      "type": "header",
      "content": "Visual Source Comparison"
    },
    {
      "type": "image_picker",
      "id": "juice_img",
      "label": "Juice photo override"
    },
    {
      "type": "text",
      "id": "juice_title",
      "label": "Juice caption title",
      "default": "Juice"
    },
    {
      "type": "text",
      "id": "juice_desc",
      "label": "Juice caption description",
      "default": "Soluble PACs — free to be absorbed"
    },
    {
      "type": "image_picker",
      "id": "pomace_img",
      "label": "Pomace photo override"
    },
    {
      "type": "text",
      "id": "pomace_title",
      "label": "Pomace caption title",
      "default": "Pomace"
    },
    {
      "type": "text",
      "id": "pomace_desc",
      "label": "Pomace caption description",
      "default": "Insoluble PACs — trapped in fibre"
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button text",
      "default": "Buy ellura"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Chart Options"
    },
    {
      "type": "text",
      "id": "chart_axis",
      "label": "Chart axis label",
      "default": "Anti-adhesion activity %"
    },
    {
      "type": "textarea",
      "id": "chart_note",
      "label": "Chart disclaimer note",
      "default": "*Insoluble PACs from pomace remain trapped in fibre and have negligible anti-adhesion effect in vivo."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Clinical Point",
      "settings": [
        {
          "type": "text",
          "id": "point_number",
          "label": "Point index (01, 02, 03)",
          "default": "01"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Point text",
          "default": "<p><strong>ellura’s</strong> difference lies in its 36 mg of soluble, bioactive A-type PACs — a clinically backed formula with superior absorption and the highest concentration of active PACs, the key component to help reduce the ability of certain bacteria from adhering to the urinary tract.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Ellura Is Different",
      "blocks": [
        {
          "type": "point",
          "settings": {
            "point_number": "01",
            "text": "<p><strong>ellura’s</strong> difference lies in its 36 mg of soluble, bioactive A-type PACs — a clinically backed formula with superior absorption and the highest concentration of active PACs, the key component to help reduce the ability of certain bacteria from adhering to the urinary tract.</p>"
          }

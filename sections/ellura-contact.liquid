{% comment %}
  Section contract.
  ellura-contact renders the "Send us a message" block (reference Support): copy and quick links
  beside a Shopify contact form with topic, optional order number, message and consent.
  Messages arrive in the store's customer email inbox.
  @example
  <!-- page.contact template, below the contact channels -->
{% endcomment %}
{%- liquid
  assign topics = section.settings.topics | newline_to_br | split: '<br />'
  assign form_id = 'ellura-contact-' | append: section.id
-%}
<div class="section tone-bone" id="contact-{{ section.id }}">
  <div class="wrap two-col">
    <div class="stack">
      <h2 class="t-d3" data-split>{{ section.settings.heading }}</h2>
      {%- if section.settings.body != blank -%}
        <p class="t-body" data-fade>{{ section.settings.body }}</p>
      {%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ul class="quicklinks" role="list" data-stagger>
          {%- for block in section.blocks -%}
            <li {{ block.shopify_attributes }}>
              <a href="{{ block.settings.link | default: '#' }}">
                {% render 'ellura-icon', name: block.settings.icon %}
                {{ block.settings.label | escape }}
                {% render 'ellura-icon', name: 'arrow' %}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="card">
      {%- form 'contact', id: form_id, class: 'form-grid' -%}
        {%- if form.posted_successfully? -%}
          <div class="note note--success span-2" role="status" tabindex="-1" autofocus>
            {% render 'ellura-icon', name: 'check', px: 18 %}
            <div>{{ section.settings.success | escape }}</div>
          </div>
        {%- elsif form.errors -%}
          <div class="note note--error span-2" role="alert">
            {% render 'ellura-icon', name: 'info', px: 18 %}
            <div>{{ form.errors | default_errors }}</div>
          </div>
        {%- endif -%}
        <div class="field">
          <label class="field__label" for="{{ form_id }}-name">Name</label>
          <input id="{{ form_id }}-name" name="contact[name]" class="input" required autocomplete="name" value="{{ form.name }}">
        </div>
        <div class="field">
          <label class="field__label" for="{{ form_id }}-email">Email</label>
          <input id="{{ form_id }}-email" name="contact[email]" type="email" class="input" required autocomplete="email" value="{{ form.email }}">
        </div>
        <div class="field">
          <label class="field__label" for="{{ form_id }}-topic">Topic</label>
          <select id="{{ form_id }}-topic" name="contact[topic]" class="select" required>
            <option value="" disabled selected>Choose…</option>
            {%- for topic in topics -%}
              {%- assign topic_text = topic | strip -%}
              {%- if topic_text != blank -%}
                <option>{{ topic_text | escape }}</option>
              {%- endif -%}
            {%- endfor -%}
          </select>
        </div>
        <div class="field">
          <label class="field__label" for="{{ form_id }}-order">Order number (optional)</label>
          <input id="{{ form_id }}-order" name="contact[order]" class="input">
        </div>
        <div class="field span-2">
          <label class="field__label" for="{{ form_id }}-msg">Message</label>
          <textarea id="{{ form_id }}-msg" name="contact[body]" class="textarea" required minlength="10">{{ form.body }}</textarea>
        </div>
        <label class="check span-2">
          <input type="checkbox" name="contact[consent]" value="yes" required>
          {{ section.settings.consent | escape }}
        </label>
        <button type="submit" class="btn btn--lg span-2">{{ section.settings.submit | escape }}</button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "class": "section-ellura-contact",
  "settings": [
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Send us a message" },
    { "type": "inline_richtext", "id": "body", "label": "Text", "default": "Tell us what you need and we’ll get back to you by email. For a side effect, please also speak to your doctor." },
    { "type": "textarea", "id": "topics", "label": "Topics", "info": "One per line.", "default": "Order or delivery\nSubscription\nReturns or refund\nProduct question\nReport a side effect\nAuthenticity concern\nSomething else" },
    { "type": "text", "id": "consent", "label": "Consent text", "default": "I agree that ellura may use these details to respond to my request." },
    { "type": "text", "id": "submit", "label": "Button label", "default": "Send message" },
    { "type": "text", "id": "success", "label": "Success message", "default": "Thanks — message received. We’ll reply by email." }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Quick link",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [{"value": "capsule", "label": "Capsule"}, {"value": "drop", "label": "Drop"}, {"value": "leaf", "label": "Leaf"}, {"value": "wheat", "label": "Wheat"}, {"value": "dna", "label": "Dna"}, {"value": "cube", "label": "Cube"}, {"value": "flask", "label": "Flask"}, {"value": "shield", "label": "Shield"}, {"value": "check", "label": "Check"}, {"value": "info", "label": "Info"}, {"value": "bolt", "label": "Bolt"}, {"value": "repeat", "label": "Repeat"}, {"value": "pause", "label": "Pause"}, {"value": "truck", "label": "Truck"}, {"value": "box", "label": "Box"}, {"value": "bag", "label": "Bag"}, {"value": "store", "label": "Store"}, {"value": "gift", "label": "Gift"}, {"value": "pin", "label": "Pin"}, {"value": "mail", "label": "Mail"}, {"value": "phone", "label": "Phone"}, {"value": "chat", "label": "Chat"}, {"value": "lock", "label": "Lock"}, {"value": "user", "label": "User"}, {"value": "star", "label": "Star"}, {"value": "search", "label": "Search"}, {"value": "arrow", "label": "Arrow"}], "default": "truck" },
        { "type": "text", "id": "label", "label": "Label", "default": "Track your order" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Contact form", "category": "ellura" }]
}
{% endschema %}

{% comment %}
  Section contract:
  ellura-faq renders the Frequently Asked Questions accordion section
  featuring interactive 2-column or 1-column accordion pills, contact CTA, and full Theme Editor controls.
{% endcomment %}

<div
  id="faq-{{ section.id }}"
  class="faq-t section"
  style="--faq-bg: {{ section.settings.bg_color }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background: var(--faq-bg);"
  {{ section.shopify_attributes }}
>
  <div class="wrap wrap--narrow">
    <header class="faq-t__head">
      <h2 id="faq-t-title-{{ section.id }}" class="t-d2" data-split>
        {{ section.settings.heading | default: 'FAQs' }}
      </h2>

      {% if section.settings.lead != blank %}
        <p class="t-lead" data-fade>{{ section.settings.lead }}</p>
      {% endif %}

      {% if section.settings.contact_btn_label != blank %}
        <a href="{{ section.settings.contact_btn_url | default: '/pages/contact' }}" class="btn" data-fade>
          {{ section.settings.contact_btn_label | escape }}
        </a>
      {% endif %}
    </header>

    {% if section.settings.group_title != blank %}
      <h3 class="faq-t__group t-h4" data-fade>
        {{ section.settings.group_title }}
      </h3>
    {% endif %}

    <div class="accordion faq-grid">
      {% for block in section.blocks %}
        {% if block.type == 'question' %}
          <div class="acc acc--pill {% if forloop.first and section.settings.first_open %}is-open{% endif %}" id="acc-{{ block.id }}" {{ block.shopify_attributes }}>
            <h4 class="acc__heading">
              <button
                type="button"
                id="acc-btn-{{ block.id }}"
                class="acc__btn"
                aria-expanded="{% if forloop.first and section.settings.first_open %}true{% else %}false{% endif %}"
                aria-controls="acc-panel-{{ block.id }}"
              >
                <span class="acc__title">{{ block.settings.question | escape }}</span>
                <span class="acc__icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                </span>
              </button>
            </h4>
            <div
              id="acc-panel-{{ block.id }}"
              role="region"
              aria-labelledby="acc-btn-{{ block.id }}"
              class="acc__panel"
              style="{% unless forloop.first and section.settings.first_open %}display: none;{% endunless %}"
            >
              <div class="acc__inner">
                {{ block.settings.answer }}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.see_all_label != blank %}
      <p class="faq-t__more" data-fade>
        <a href="{{ section.settings.see_all_url | default: '/pages/faq' }}" class="text-link">
          {{ section.settings.see_all_label | escape }}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </p>
    {% endif %}
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('faq-{{ section.id }}');
    if (!root) return;

    root.querySelectorAll('.acc__btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var acc = btn.closest('.acc');
        var panel = acc.querySelector('.acc__panel');
        var isOpen = acc.classList.contains('is-open');

        if (isOpen) {
          acc.classList.remove('is-open');
          btn.setAttribute('aria-expanded', 'false');
          if (panel) panel.style.display = 'none';
        } else {
          acc.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
          if (panel) panel.style.display = 'block';
        }

        if (typeof ScrollTrigger !== 'undefined') {
          ScrollTrigger.refresh();
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "FAQ Accordion",
  "tag": "section",
  "class": "section-ellura-faq",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FAQs"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Description",
      "default": "We’re here to help! Below you’ll find answers to some of our most frequently asked questions. If you need further assistance, feel free to reach out — our team will be in touch shortly."
    },
    {
      "type": "text",
      "id": "contact_btn_label",
      "label": "Contact button label",
      "default": "Contact us"
    },
    {
      "type": "url",
      "id": "contact_btn_url",
      "label": "Contact button URL"
    },
    {
      "type": "text",
      "id": "group_title",
      "label": "Group subtitle",
      "default": "About <span class='brand-word'>ellura</span>"
    },
    {
      "type": "checkbox",
      "id": "first_open",
      "label": "Keep first question open by default",
      "default": true
    },
    {
      "type": "text",
      "id": "see_all_label",
      "label": "See all FAQs link text",
      "default": "See all FAQs"
    },
    {
      "type": "url",
      "id": "see_all_url",
      "label": "See all FAQs URL"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background color",
      "default": "#f4e8f6"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is ellura?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>ellura is a clinically backed supplement that supports urinary tract health and helps reduce the ability of certain bacteria to adhere to the urinary tract, allowing them to be flushed out naturally.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "What is ellura?",
            "answer": "<p>ellura is a clinically backed supplement that supports urinary tract health and helps reduce the ability of certain bacteria to adhere to the urinary tract, allowing them to be flushed out naturally.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What are the ingredients in ellura?",
            "answer": "<p>Each capsule delivers 36 mg of soluble, bioactive proanthocyanidins (PACs) from 206 mg of concentrated cranberry fruit juice extract powder (Gikacran®), the key clinically studied compound.</p><p>Clean vegetarian capsule shell with no GMOs, gluten, added sugars, or artificial dyes.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How do I take ellura?",
            "answer": "<p>Take 1 capsule once daily with water, at the same time each day.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How is ellura different from cranberry juice or pills?",
            "answer": "<p>Unlike generic cranberry pills made from leftover pomace (stems and seeds), ellura is derived exclusively from 100% concentrated cranberry fruit juice, delivering soluble, bioavailable PACs that your body can actually absorb.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}

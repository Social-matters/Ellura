{% comment %}
  Section contract:
  ellura-footer renders the custom lilac luxury footer with clover background watermark,
  brand introduction, newsletter signup, navigation columns, giant wordmark, and medical disclaimers.
{% endcomment %}

<footer
  id="ellura-footer-{{ section.id }}"
  class="footer"
  style="--footer-bg: {{ section.settings.bg_color }}; --footer-color: {{ section.settings.text_color }}; background: var(--footer-bg); color: var(--footer-color);"
  {{ section.shopify_attributes }}
>
  <!-- Clover Watermark Graphic -->
  <svg class="footer__clover" viewBox="0 0 100 100" fill="currentColor" aria-hidden="true">
    <path d="M50 49.5C45.5 43 32 36.5 31.2 24.5 30.6 15.6 36.6 9 43.2 9c3.6 0 5.8 2 6.8 4.2C51 11 53.2 9 56.8 9c6.6 0 12.6 6.6 12 15.5C68 36.5 54.5 43 50 49.5Z" />
    <path d="M49.5 50C43 54.5 36.5 68 24.5 68.8 15.6 69.4 9 63.4 9 56.8c0-3.6 2-5.8 4.2-6.8C11 49 9 46.8 9 43.2c0-6.6 6.6-12.6 15.5-12C36.5 32 43 45.5 49.5 50Z" />
    <path d="M50 50.5C54.5 57 68 63.5 68.8 75.5c.6 8.9-5.4 15.5-12 15.5-3.6 0-5.8-2-6.8-4.2C49 89 46.8 91 43.2 91c-6.6 0-12.6-6.6-12-15.5C32 63.5 45.5 57 50 50.5Z" />
    <path d="M50.5 50C57 45.5 63.5 32 75.5 31.2 84.4 30.6 91 36.6 91 43.2c0 3.6-2 5.8-4.2 6.8C89 51 91 53.2 91 56.8c0 6.6-6.6 12.6-15.5 12C63.5 68 57 54.5 50.5 50Z" />
  </svg>

  <div class="wrap">
    <div class="footer__top">
      <!-- Left Brand Intro & Newsletter -->
      <div class="footer__intro">
        <a href="{{ routes.root_url }}" class="header__logo" aria-label="ellura home">
          <img src="{{ 'ellura-logo-plum.png' | asset_url }}" alt="ellura®" width="154" height="30" loading="lazy">
        </a>

        {% if section.settings.lead != blank %}
          <p class="t-lead">{{ section.settings.lead }}</p>
        {% endif %}

        {% if section.settings.show_newsletter %}
          <div class="newsletter">
            {% form 'customer', class: 'newsletter-form' %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="newsletter__row">
                <input
                  type="email"
                  name="contact[email]"
                  class="newsletter__input"
                  placeholder="{{ section.settings.newsletter_placeholder | default: 'Enter your email' }}"
                  required
                >
                <button type="submit" class="newsletter__btn">
                  {{ section.settings.newsletter_btn | default: 'Subscribe' }}
                </button>
              </div>
              {% if form.posted_successfully? %}
                <p class="newsletter__msg" style="color: #2e7d32;">Thanks for subscribing!</p>
              {% endif %}
            {% endform %}
          </div>
        {% endif %}
      </div>

      <!-- Footer Menu Columns -->
      <div class="footer__cols">
        {% for block in section.blocks %}
          {% if block.type == 'link_column' %}
            <div class="footer__col" {{ block.shopify_attributes }}>
              <p class="footer__col-title">{{ block.settings.title | escape }}</p>
              <ul role="list">
                {% if block.settings.menu != blank %}
                  {% for link in linklists[block.settings.menu].links %}
                    <li>
                      <a href="{{ link.url }}">{{ link.title | escape }}</a>
                    </li>
                  {% endfor %}
                {% else %}
                  <!-- Fallback links -->
                  {% case block.settings.title %}
                    {% when 'Shop' %}
                      <li><a href="{{ routes.all_products_collection_url }}">30 Capsules</a></li>
                      <li><a href="{{ routes.all_products_collection_url }}">90 Capsules</a></li>
                      <li><a href="{{ routes.all_products_collection_url }}">180 Capsules</a></li>
                      <li><a href="/pages/subscribe">Subscribe & Save</a></li>
                    {% when 'Science' %}
                      <li><a href="/pages/how-it-works">How it works</a></li>
                      <li><a href="/pages/science">The 36 mg Standard</a></li>
                      <li><a href="/pages/clinical-studies">Clinical Studies</a></li>
                      <li><a href="/pages/faq">FAQs</a></li>
                    {% when 'Company' %}
                      <li><a href="/pages/our-story">Our Story</a></li>
                      <li><a href="/pages/pharmatoka">Pharmatoka France</a></li>
                      <li><a href="/pages/contact">Contact Us</a></li>
                    {% else %}
                      <li><a href="/policies/privacy-policy">Privacy Policy</a></li>
                      <li><a href="/policies/terms-of-service">Terms of Service</a></li>
                      <li><a href="/policies/shipping-policy">Shipping Policy</a></li>
                  {% endcase %}
                {% endif %}
              </ul>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <!-- Contact Row -->
    <div class="footer__contact">
      <span class="footer__contact-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        <span>{{ section.settings.email | default: 'hello@ellurautihealth.com' }}</span>
      </span>
      <span class="footer__contact-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        <span>{{ section.settings.origin | default: 'Formulated in France · Distributed in India' }}</span>
      </span>
    </div>
  </div>

  <!-- Giant wordmark: rises into place as the footer scrolls in -->
  <div class="footer__word" aria-hidden="true">
    <img src="{{ 'ellura-logo-plum.png' | asset_url }}" alt="" width="1200" height="233" loading="lazy" decoding="async">
  </div>

  <div class="wrap">
    <!-- Legal Disclaimer -->
    {% if section.settings.disclaimer != blank %}
      <div class="footer__legal">
        <p>{{ section.settings.disclaimer }}</p>
      </div>
    {% endif %}

    <!-- Copyright -->
    <div class="footer__copy">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
    </div>
  </div>
</footer>

<script>
  (function () {
    function initFooterMotion() {
      if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;
      var root = document.getElementById('ellura-footer-{{ section.id }}');
      if (!root) return;

      if (root._footerMM) root._footerMM.revert();
      var mm = gsap.matchMedia();
      root._footerMM = mm;
      mm.add('(prefers-reduced-motion: no-preference)', function () {
        var word = root.querySelector('.footer__word');
        var wordImg = root.querySelector('.footer__word img');
        if (word && wordImg) {
          gsap.fromTo(wordImg,
            { yPercent: 40, opacity: 0.3 },
            {
              yPercent: 0,
              opacity: 1,
              ease: 'none',
              scrollTrigger: { trigger: word, start: 'top bottom', end: 'bottom bottom', scrub: 0.6 }
            }
          );
        }

        var clover = root.querySelector('.footer__clover');
        if (clover) {
          gsap.to(clover, {
            rotate: 120,
            ease: 'none',
            scrollTrigger: { trigger: root, start: 'top bottom', end: 'bottom bottom', scrub: 1 }
          });
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFooterMotion);
    } else {
      initFooterMotion();
    }

    document.addEventListener('shopify:section:load', function (e) {
      if (e.target.id === 'shopify-section-{{ section.id }}') initFooterMotion();
    });
  })();
</script>

{% schema %}
{
  "name": "Ellura Luxury Footer",
  "tag": "section",
  "class": "section-ellura-footer",
  "settings": [
    {
      "type": "textarea",
      "id": "lead",
      "label": "Brand lead message",
      "default": "Urinary tract health, backed by 20+ years of cranberry research. Now available in India."
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Newsletter input placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "newsletter_btn",
      "label": "Newsletter button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Support email",
      "default": "hello@ellurautihealth.com"
    },
    {
      "type": "text",
      "id": "origin",
      "label": "Origin note",
      "default": "Formulated in France · Distributed in India"
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Medical disclaimer note",
      "default": "*These statements have not been evaluated by the Food and Drug Administration or FSSAI. This product is a dietary supplement and is not intended to diagnose, treat, cure, or prevent any disease. Consult your physician before starting any dietary supplement."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Footer background color",
      "default": "#d0a6d8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Footer text color",
      "default": "#2d1430"
    }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Navigation Column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Column title",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu (optional linklist)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ellura Luxury Footer",
      "blocks": [
        { "type": "link_column", "settings": { "title": "Shop" } },
        { "type": "link_column", "settings": { "title": "Science" } },
        { "type": "link_column", "settings": { "title": "Company" } },
        { "type": "link_column", "settings": { "title": "Legal" } }
      ]
    }
  ]
}
{% endschema %}

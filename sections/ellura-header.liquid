{% comment %}
  Section contract:
  ellura-header renders the luxury sticky header bar matching the exact ellura website:
  - Announcement bar with GSAP rotating messages and prev/next controls
  - Sticky glassmorphic navbar with plum brand logo
  - Left & Right navigation links
  - Mobile slide-in drawer
  - Search trigger, account link, cart drawer toggle with dynamic badge
  - "Shop now" pill button
{% endcomment %}

<div
  id="ellura-header-wrapper-{{ section.id }}"
  class="ellura-header-wrapper"
  style="
    --header-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    --header-text: {{ section.settings.text_color | default: '#2d1430' }};
    --announce-bg: {{ section.settings.announce_bg | default: '#5a2e58' }};
    --announce-text: {{ section.settings.announce_text | default: '#fbeffb' }};
    position: relative;
  "
  {{ section.shopify_attributes }}
>
  {% if section.settings.show_announcements %}
    <!-- Announcement Bar -->
    <div
      class="announce"
      role="region"
      aria-roledescription="carousel"
      aria-label="Announcements"
      style="background: var(--announce-bg); color: var(--announce-text);"
    >
      <button class="announce__btn" id="announce-prev-{{ section.id }}" aria-label="Previous announcement">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      </button>

      <div class="announce__viewport" style="overflow: hidden; text-align: center; width: 100%; max-width: 600px; height: 24px; position: relative; display: flex; align-items: center; justify-content: center;">
        <p id="announce-text-{{ section.id }}" class="announce__text" aria-live="polite">
          {{ section.settings.announcement_1 }}
        </p>
      </div>

      <button class="announce__btn" id="announce-next-{{ section.id }}" aria-label="Next announcement">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>
  {% endif %}

  <!-- Main Header Bar -->
  <header class="header" id="header-main-{{ section.id }}" style="background: var(--header-bg); position: relative; z-index: 10;">
    <div class="header__bar wrap">
      <!-- Mobile Burger Button -->
      <button
        class="icon-btn header__burger"
        id="header-burger-{{ section.id }}"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu-{{ section.id }}"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
      </button>

      <!-- Brand Logo -->
      <a href="{{ routes.root_url }}" class="header__logo" aria-label="{{ shop.name }} home" style="display: flex; align-items: center; height: 32px; max-height: 32px;">
        {% if section.settings.logo != blank %}
          <img
            src="{{ section.settings.logo | image_url: width: 360 }}"
            alt="{{ shop.name }}"
            width="{{ section.settings.logo_width | default: 140 }}"
            height="32"
            style="height: 32px !important; max-height: 32px !important; width: auto !important; max-width: 160px !important; object-fit: contain; display: block;"
            loading="eager"
            fetchpriority="high"
          >
        {% else %}
          <img
            src="{{ 'ellura-logo-plum.png' | asset_url }}"
            alt="ellura®"
            width="{{ section.settings.logo_width | default: 140 }}"
            height="32"
            style="height: 32px !important; max-height: 32px !important; width: auto !important; max-width: 160px !important; object-fit: contain; display: block;"
            loading="eager"
            fetchpriority="high"
          >
        {% endif %}
      </a>

      <!-- Desktop Nav -->
      <nav class="header__nav" aria-label="Main navigation">
        <ul role="list">
          {% if section.settings.menu != blank %}
            {%- assign mega_title = section.settings.mega_label | downcase | strip -%}
            {% for link in linklists[section.settings.menu].links %}
              {%- assign link_title = link.title | downcase | strip -%}
              {% if section.settings.mega_enabled and link_title == mega_title %}
              <li class="header__mega-item" data-mega-item>
                <button type="button" class="header__link{% if template.name == 'collection' or template.name == 'product' %} is-active{% endif %}" aria-expanded="false" aria-controls="shop-panel-{{ section.id }}" data-mega-trigger>
                  {{ section.settings.mega_label | escape }}
                  {% render 'ellura-icon', name: 'chevron', px: 14 %}
                </button>
              </li>
              {% else %}
              <li>
                <a href="{{ link.url }}" class="header__link {% if link.active %}is-active{% endif %}">
                  {{ link.title | escape }}
                </a>
              </li>
              {% endif %}
            {% endfor %}
          {% else %}
            <!-- Default ellura Navigation -->
            {% if section.settings.mega_enabled %}
              <li class="header__mega-item" data-mega-item>
                <button type="button" class="header__link{% if template.name == 'collection' or template.name == 'product' %} is-active{% endif %}" aria-expanded="false" aria-controls="shop-panel-{{ section.id }}" data-mega-trigger>
                  {{ section.settings.mega_label | escape }}
                  {% render 'ellura-icon', name: 'chevron', px: 14 %}
                </button>
              </li>
            {% else %}
              <li><a href="{{ routes.all_products_collection_url }}" class="header__link">Shop</a></li>
            {% endif %}
            <li><a href="/pages/how-it-works" class="header__link">How it works</a></li>
            <li><a href="/pages/the-science" class="header__link">The Science</a></li>
            <li><a href="/blogs/news" class="header__link">Learn</a></li>
            <li><a href="/pages/reviews" class="header__link">Reviews</a></li>
            <li><a href="/pages/faq" class="header__link">FAQs</a></li>
          {% endif %}
        </ul>
      </nav>

      <!-- Right Header Actions -->
      <div class="header__actions">
        {% if section.settings.show_search %}
          <button
            class="icon-btn header__search"
            aria-label="Search"
            onclick="document.querySelector('search-modal')?.showModal?.() || document.querySelector('[data-search-trigger]')?.click();"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </button>
        {% endif %}

        {% if shop.customer_accounts_enabled and section.settings.show_account %}
          <a href="{{ routes.account_url }}" class="icon-btn header__account" aria-label="My account">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 1 0-16 0"/></svg>
          </a>
        {% endif %}

        {% if section.settings.show_cart %}
          <a
            href="{{ routes.cart_url }}"
            class="icon-btn header__cart"
            aria-label="Open cart, {{ cart.item_count }} items"
            onclick="event.preventDefault(); if (window.theme?.cartDrawer) { window.theme.cartDrawer.open(); } else { document.querySelector('cart-drawer')?.open?.(); }"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            <span class="header__count" id="header-cart-count-{{ section.id }}" aria-hidden="true">
              {{ cart.item_count }}
            </span>
          </a>
        {% endif %}

        {% if section.settings.cta_text != blank %}
          <a href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}" class="btn btn--sm header__cta">
            {{ section.settings.cta_text }}
          </a>
        {% endif %}
      </div>
    </div>

    {%- if section.settings.mega_enabled -%}
      {%- liquid
        assign mega_products = section.settings.mega_products
        if mega_products == blank or mega_products.size == 0
          assign mega_products = collections.all.products
        endif
        assign mega_badges = section.settings.mega_badges | newline_to_br | split: '<br />'
        assign mega_tones = 'blush,lilac,butter' | split: ','
      -%}
      <div id="shop-panel-{{ section.id }}" class="mega" aria-hidden="true" inert data-mega-panel>
        <div class="mega__inner wrap">
          <ul role="list" class="mega__products">
            {%- for product in mega_products limit: 3 -%}
              {%- liquid
                assign tone_index = forloop.index0 | modulo: 3
                assign badge = product.metafields.custom.badge.value
                if badge == blank
                  assign badge = mega_badges[forloop.index0] | strip
                endif
              -%}
              <li>
                <a href="{{ product.url }}" class="mega__tile pcard--{{ mega_tones[tone_index] }}">
                  <span class="mega__img">
                    {%- if product.featured_image -%}
                      {{ product.featured_image | image_url: width: 520 | image_tag: alt: '', width: 260, height: 260, loading: 'lazy' }}
                    {%- endif -%}
                  </span>
                  {%- if badge != blank -%}<span class="chip chip--solid">{{ badge | escape }}</span>{%- endif -%}
                  <strong>{{ product.title | escape }}</strong>
                  <span class="mega__sub">{% if product.available %}{{ product.price | money_without_trailing_zeros }}{% else %}Price at launch{% endif %}</span>
                </a>
              </li>
            {%- endfor -%}
          </ul>
          <div class="mega__side">
            {%- if section.settings.mega_link_1_label != blank -%}
              <a href="{{ section.settings.mega_link_1_url | default: routes.all_products_collection_url }}" class="mega__link">{{ section.settings.mega_link_1_label | escape }} {% render 'ellura-icon', name: 'arrow', px: 18 %}</a>
            {%- endif -%}
            {%- if section.settings.mega_link_2_label != blank -%}
              <a href="{{ section.settings.mega_link_2_url | default: '/pages/subscribe' }}" class="mega__link">{{ section.settings.mega_link_2_label | escape }} {% render 'ellura-icon', name: 'arrow', px: 18 %}</a>
            {%- endif -%}
            {%- if section.settings.mega_link_3_label != blank -%}
              <a href="{{ section.settings.mega_link_3_url | default: '/pages/where-to-buy' }}" class="mega__link">{{ section.settings.mega_link_3_label | escape }} {% render 'ellura-icon', name: 'arrow', px: 18 %}</a>
            {%- endif -%}
            {%- if section.settings.mega_promo_heading != blank -%}
              <a href="{{ section.settings.mega_promo_url | default: '/pages/subscribe' }}" class="mega__promo">
                <span class="t-mono">{{ section.settings.mega_promo_eyebrow | escape }}</span>
                <span class="t-d3">{{ section.settings.mega_promo_heading }}</span>
                <span class="t-sm">{{ section.settings.mega_promo_text | escape }}</span>
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}
  </header>
  {%- if section.settings.mega_enabled -%}
    {%- comment -%} Below the header bar (z-index 10) but above the page. {%- endcomment -%}
    <div class="mega-scrim" aria-hidden="true" style="z-index: 5;" data-mega-scrim></div>
  {%- endif -%}

  <!-- Mobile menu: full-screen plum panel revealed with a circular clip from the burger -->
  <div id="mobile-menu-{{ section.id }}" class="mmenu" style="visibility: hidden;" aria-hidden="true" inert>
    <div class="mmenu__panel on-dark" role="dialog" aria-modal="true" aria-label="Menu" data-mmenu-panel>
      <div class="mmenu__top">
        <button type="button" class="icon-btn" id="mobile-menu-close-{{ section.id }}" aria-label="Close menu">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
        </button>
        <img src="{{ 'ellura-logo-white.png' | asset_url }}" alt="ellura®" width="124" height="24" style="height: 24px; width: auto;">
        {% if section.settings.show_search %}
          <button type="button" class="icon-btn" data-mmenu-search aria-label="Search">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </button>
        {% else %}
          <span aria-hidden="true" style="width: 44px;"></span>
        {% endif %}
      </div>

      <div class="mmenu__scroll" data-lenis-prevent>
        <nav aria-label="Mobile">
          <ul role="list" class="mmenu__big">
            {% if section.settings.menu != blank %}
              {% for link in linklists[section.settings.menu].links %}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {% endfor %}
            {% else %}
              <li><a href="{{ routes.all_products_collection_url }}">Shop all</a></li>
              <li><a href="/pages/how-it-works">How it works</a></li>
              <li><a href="/pages/the-science">The Science</a></li>
              <li><a href="/blogs/news">Learn</a></li>
              <li><a href="/pages/reviews">Reviews</a></li>
              <li><a href="/pages/faq">FAQs</a></li>
              <li><a href="/pages/subscribe">Subscribe &amp; Save</a></li>
              <li><a href="/pages/where-to-buy">Where to buy</a></li>
            {% endif %}
          </ul>
        </nav>

        <div class="mmenu__rest mmenu__products">
          <a href="{{ routes.all_products_collection_url }}">
            <img src="{{ 'pack-30-700.webp' | asset_url }}" alt="" width="120" height="120" loading="lazy">
            <span>30 capsules</span>
          </a>
          <a href="{{ routes.all_products_collection_url }}">
            <img src="{{ 'pack-90-700.webp' | asset_url }}" alt="" width="120" height="120" loading="lazy">
            <span>90 capsules</span>
          </a>
          <a href="{{ routes.all_products_collection_url }}">
            <img src="{{ 'pack-180-700.webp' | asset_url }}" alt="" width="120" height="120" loading="lazy">
            <span>180 capsules (2 × 90)</span>
          </a>
        </div>

        <ul role="list" class="mmenu__rest mmenu__small">
          {% if shop.customer_accounts_enabled %}
            <li>
              <a href="{{ routes.account_url }}">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 1 0-16 0"/></svg>
                My account
              </a>
            </li>
          {% endif %}
          <li>
            <a href="/pages/contact">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              Help &amp; Support
            </a>
          </li>
          <li>
            <a href="/pages/our-story">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
              Our story
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    var wrapper = document.getElementById('ellura-header-wrapper-{{ section.id }}');
    if (!wrapper) return;
    var header = document.getElementById('header-main-{{ section.id }}');
    var burger = document.getElementById('header-burger-{{ section.id }}');
    var menu = document.getElementById('mobile-menu-{{ section.id }}');
    var menuOpen = false;

    function hasGsap() {
      return typeof gsap !== 'undefined';
    }
    function reducedMotion() {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }

    /* ---- Announcement carousel: rotates every 5.2s, pauses on hover/focus ---- */
    var messages = [
      {{ section.settings.announcement_1 | json }},
      {{ section.settings.announcement_2 | json }},
      {{ section.settings.announcement_3 | json }}
    ].filter(Boolean);
    var textEl = document.getElementById('announce-text-{{ section.id }}');
    var announce = textEl ? textEl.closest('.announce') : null;
    var current = 0;
    var paused = false;
    var timer = null;

    function showAnnouncement(idx) {
      if (!textEl) return;
      current = (idx + messages.length) % messages.length;
      textEl.textContent = messages[current];
      if (hasGsap() && !reducedMotion()) {
        gsap.fromTo(textEl, { yPercent: 70, opacity: 0 }, { yPercent: 0, opacity: 1, duration: 0.55, ease: 'power3.out' });
      }
    }

    function restartTimer() {
      window.clearInterval(timer);
      if (paused || reducedMotion() || messages.length < 2) return;
      timer = window.setInterval(function () {
        showAnnouncement(current + 1);
      }, 5200);
    }

    function setPaused(value) {
      paused = value;
      textEl.setAttribute('aria-live', value ? 'polite' : 'off');
      restartTimer();
    }

    if (announce && messages.length > 1) {
      var prevBtn = document.getElementById('announce-prev-{{ section.id }}');
      var nextBtn = document.getElementById('announce-next-{{ section.id }}');
      if (prevBtn) {
        prevBtn.addEventListener('click', function () {
          showAnnouncement(current - 1);
          restartTimer();
        });
      }
      if (nextBtn) {
        nextBtn.addEventListener('click', function () {
          showAnnouncement(current + 1);
          restartTimer();
        });
      }
      announce.addEventListener('pointerenter', function () { setPaused(true); });
      announce.addEventListener('pointerleave', function () { setPaused(false); });
      announce.addEventListener('focusin', function () { setPaused(true); });
      announce.addEventListener('focusout', function () { setPaused(false); });
      textEl.setAttribute('aria-live', 'off');
      restartTimer();
    }

    /* ---- Scroll state: solid after 8px, hide when scrolling down fast past 240px ---- */
    function initScrollState() {
      if (!header || typeof ScrollTrigger === 'undefined') return;
      if (wrapper._scrollState) wrapper._scrollState.kill();
      wrapper._scrollState = ScrollTrigger.create({
        start: 0,
        end: 'max',
        onUpdate: function (self) {
          var y = self.scroll();
          header.classList.toggle('is-solid', y > 8 || menuOpen);
          if (y < 240) {
            header.classList.remove('is-hidden');
          } else if (Math.abs(self.getVelocity()) > 40 && !menuOpen && !megaIsOpen()) {
            header.classList.toggle('is-hidden', self.direction === 1);
          }
        }
      });
      header.classList.toggle('is-solid', window.scrollY > 8);
    }

    /* ---- Shop mega menu: hover or click opens; leave, Escape, scrim or focus out closes ---- */
    var megaTrigger = wrapper.querySelector('[data-mega-trigger]');
    var megaPanel = wrapper.querySelector('[data-mega-panel]');
    var megaScrim = wrapper.querySelector('[data-mega-scrim]');
    var megaTimer = null;

    function megaIsOpen() {
      return !!(megaPanel && megaPanel.classList.contains('is-open'));
    }
    function setMega(open) {
      if (!megaTrigger || !megaPanel) return;
      window.clearTimeout(megaTimer);
      megaTrigger.setAttribute('aria-expanded', String(open));
      megaPanel.classList.toggle('is-open', open);
      megaPanel.setAttribute('aria-hidden', String(!open));
      if (open) megaPanel.removeAttribute('inert');
      else megaPanel.setAttribute('inert', '');
      if (megaScrim) megaScrim.classList.toggle('is-open', open);
      if (open && header) {
        header.classList.remove('is-hidden');
        header.classList.add('is-solid');
      }
    }
    function closeMegaSoon() {
      window.clearTimeout(megaTimer);
      megaTimer = window.setTimeout(function () { setMega(false); }, 160);
    }

    if (megaTrigger && megaPanel && header) {
      megaTrigger.addEventListener('click', function () {
        setMega(!megaIsOpen());
      });
      if (window.matchMedia('(hover: hover)').matches) {
        megaTrigger.closest('[data-mega-item]').addEventListener('mouseenter', function () { setMega(true); });
        megaPanel.addEventListener('mouseenter', function () { window.clearTimeout(megaTimer); });
        header.querySelectorAll('.header__nav li:not([data-mega-item])').forEach(function (li) {
          li.addEventListener('mouseenter', closeMegaSoon);
        });
        header.addEventListener('mouseleave', closeMegaSoon);
      }
      header.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && megaIsOpen()) {
          e.stopPropagation();
          setMega(false);
          megaTrigger.focus();
        }
      });
      header.addEventListener('focusout', function (e) {
        if (!header.contains(e.relatedTarget)) setMega(false);
      });
      if (megaScrim) megaScrim.addEventListener('click', function () { setMega(false); });
    }

    /* ---- Mobile menu: circular reveal, staggered links, focus trap ---- */
    var menuTl = null;
    var lastFocus = null;
    var focusable = 'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';

    function buildMenuTimeline() {
      if (!menu || !hasGsap()) return;
      if (menuTl) menuTl.kill();
      var panel = menu.querySelector('[data-mmenu-panel]');
      var k = reducedMotion() ? 0 : 1;
      menuTl = gsap.timeline({
        paused: true,
        onReverseComplete: function () {
          menu.style.visibility = 'hidden';
        }
      })
        .set(menu, { visibility: 'visible' })
        .fromTo(panel, { clipPath: 'circle(0% at 28px 28px)' }, { clipPath: 'circle(150% at 28px 28px)', duration: 0.8 * k, ease: 'power3.inOut' })
        .fromTo(menu.querySelectorAll('.mmenu__big a'), { yPercent: 110 }, { yPercent: 0, stagger: 0.05, duration: 0.7 * k, ease: 'expo.out' }, 0.3 * k)
        .fromTo(menu.querySelectorAll('.mmenu__rest'), { opacity: 0, y: 20 }, { opacity: 1, y: 0, stagger: 0.08, duration: 0.5 * k }, 0.45 * k);
    }

    function onMenuKeydown(e) {
      if (e.key === 'Escape') {
        e.stopPropagation();
        setMenu(false);
        return;
      }
      if (e.key !== 'Tab') return;
      var items = Array.prototype.filter.call(menu.querySelectorAll(focusable), function (el) {
        return el.offsetParent !== null;
      });
      if (!items.length) return;
      var first = items[0];
      var last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }

    function setMenu(open) {
      if (!menu || open === menuOpen) return;
      menuOpen = open;
      var motion = window.elluraMotion;
      if (burger) burger.setAttribute('aria-expanded', String(open));
      menu.setAttribute('aria-hidden', String(!open));
      if (open) {
        lastFocus = document.activeElement;
        menu.removeAttribute('inert');
        if (header) header.classList.remove('is-hidden');
        if (motion) motion.lockScroll(true);
        document.addEventListener('keydown', onMenuKeydown);
        if (menuTl) menuTl.timeScale(1).play();
        else menu.style.visibility = 'visible';
        window.setTimeout(function () {
          var closeBtn = document.getElementById('mobile-menu-close-{{ section.id }}');
          if (closeBtn) closeBtn.focus({ preventScroll: true });
        }, 60);
      } else {
        menu.setAttribute('inert', '');
        if (motion) motion.lockScroll(false);
        document.removeEventListener('keydown', onMenuKeydown);
        if (menuTl) menuTl.timeScale(1.8).reverse();
        else menu.style.visibility = 'hidden';
        if (lastFocus && lastFocus.focus) lastFocus.focus({ preventScroll: true });
      }
    }

    if (burger && menu) {
      burger.addEventListener('click', function () { setMenu(true); });
      var closeBtn = document.getElementById('mobile-menu-close-{{ section.id }}');
      if (closeBtn) closeBtn.addEventListener('click', function () { setMenu(false); });
      menu.querySelectorAll('a').forEach(function (link) {
        link.addEventListener('click', function () { setMenu(false); });
      });
      var searchBtn = menu.querySelector('[data-mmenu-search]');
      var headerSearch = wrapper.querySelector('.header__search');
      if (searchBtn && headerSearch) {
        searchBtn.addEventListener('click', function () {
          setMenu(false);
          window.setTimeout(function () { headerSearch.click(); }, 250);
        });
      }
    }

    function initMotion() {
      buildMenuTimeline();
      initScrollState();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMotion);
    } else {
      initMotion();
    }

    document.addEventListener('shopify:section:unload', function (e) {
      if (e.target.id !== 'shopify-section-{{ section.id }}') return;
      window.clearInterval(timer);
      if (menuOpen) setMenu(false);
      if (wrapper._scrollState) wrapper._scrollState.kill();
      if (menuTl) menuTl.kill();
    });
  })();
</script>

{% stylesheet %}
  /*
    The section wrapper is only as tall as the header, so stickiness lives on #header-group,
    whose containing block is the page. With announcements on, the group sticks at minus the
    announcement height: the announcement scrolls away and the nav bar stays pinned.
  */
  #header-group:has(.ellura-header-wrapper) {
    position: sticky;
    top: 0;
    z-index: var(--z-header, 60);
  }

  #header-group:has(.ellura-header-wrapper .announce) {
    top: calc(var(--announce-h) * -1);
  }
{% endstylesheet %}


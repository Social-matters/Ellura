{% comment %}
  Section contract:
  ellura-heritage-stats renders the Brand Story (US to India with interactive vector route map),
  the 2x2 animated stats counter grid, and the doctor endorsement spotlight card.
  Includes full GSAP scroll-triggered animations.
{% endcomment %}

<div
  id="usin-{{ section.id }}"
  class="usin section"
  style="--usin-bg: {{ section.settings.bg_color }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background: var(--usin-bg); overflow-x: clip; max-width: 100%; width: 100%;"
  {{ section.shopify_attributes }}
>
  <div class="wrap" style="max-width: var(--max); width: 100%;">
    <div class="usin__grid" style="min-width: 0; max-width: 100%;">
      <!-- Story Card with US to India Vector Map -->
      <div class="usin__story" style="background: {{ section.settings.story_bg }}; min-width: 0; max-width: 100%;">
        {% if section.settings.story_eyebrow != blank %}
          <p class="eyebrow" data-fade>{{ section.settings.story_eyebrow | escape }}</p>
        {% endif %}

        <h2 id="usin-title-{{ section.id }}" class="t-d1" data-split>
          {{ section.settings.story_heading }}
        </h2>

        {% if section.settings.story_lead != blank %}
          <p class="t-lead" data-fade>{{ section.settings.story_lead }}</p>
        {% endif %}

        <div class="usroute" data-fade style="overflow: hidden; max-width: 100%;">
          {% render 'ellura-world-map' %}
        </div>
      </div>

      <!-- 2x2 Stats Grid -->
      <dl class="usin__stats" data-stagger style="min-width: 0; max-width: 100%;">
        {% for block in section.blocks %}
          {% if block.type == 'stat' %}
            <div class="stat stat--{{ block.settings.color_theme }}" {{ block.shopify_attributes }}>
              <dt>
                {{ block.settings.label | escape }}
                {% if block.settings.subnote != blank %}
                  <span class="stat__subnote">{{ block.settings.subnote | escape }}</span>
                {% endif %}
              </dt>
              <dd>
                <span data-count="{{ block.settings.value | escape }}">{{ block.settings.value | escape }}</span>
                {%- if block.settings.suffix != blank -%}
                  {%- if block.settings.suffix_size == 'small' -%}
                    <small>{{ block.settings.suffix | strip | escape }}</small>
                  {%- else -%}
                    {{ block.settings.suffix | escape }}
                  {%- endif -%}
                {%- endif -%}
              </dd>
            </div>
          {% endif %}
        {% endfor %}
      </dl>
    </div>

    <!-- Doctor Endorsement Card -->
    {% if section.settings.show_doctor %}
      <div class="doctor" style="background: {{ section.settings.doctor_bg }};">
        <div class="doctor__body">
          {% if section.settings.doctor_eyebrow != blank %}
            <p class="eyebrow" data-fade>{{ section.settings.doctor_eyebrow | escape }}</p>
          {% endif %}

          <div class="doctor__quote">
            <p>{{ section.settings.doctor_quote }}</p>
          </div>

          {% if section.settings.doctor_link_text != blank %}
            <a href="{{ section.settings.doctor_link_url | default: '#science' }}" class="text-link doctor__link">
              {{ section.settings.doctor_link_text | escape }}
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          {% endif %}
        </div>

        <div class="doctor__portrait">
          {% if section.settings.doctor_image != blank %}
            <img
              src="{{ section.settings.doctor_image | image_url: width: 800 }}"
              alt="{{ section.settings.doctor_name | escape }}"
              width="400"
              height="500"
              loading="lazy"
            >
          {% else %}
            <img
              src="{{ 'dr-chughtai-700.webp' | asset_url }}"
              alt="{{ section.settings.doctor_name | escape }}"
              width="400"
              height="500"
              loading="lazy"
            >
          {% endif %}

          <div class="doctor__plate">
            <strong>{{ section.settings.doctor_name | escape }}</strong>
            <em>{{ section.settings.doctor_role | escape }}</em>
          </div>
        </div>
      </div>
    {% endif %}
  </div>
</div>

<script>
  (function () {
    function initHeritageGSAP() {
      if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;
      var root = document.getElementById('usin-{{ section.id }}');
      if (!root) return;

      if (root._heritageMM) root._heritageMM.revert();
      var mm = gsap.matchMedia();
      root._heritageMM = mm;
      mm.add('(prefers-reduced-motion: no-preference)', function () {
        var routePath = root.querySelector('.usroute__path');
        var marker = root.querySelector('.usroute__marker');

        if (routePath && marker) {
          var pathLength = routePath.getTotalLength();
          gsap.set(routePath, { strokeDasharray: pathLength + ' ' + pathLength, strokeDashoffset: pathLength });
          gsap.set(marker, { opacity: 0 });

          var progressObj = { p: 0 };
          function updateMarker(p) {
            var pt = routePath.getPointAtLength(pathLength * p);
            marker.setAttribute('transform', 'translate(' + pt.x + ' ' + pt.y + ')');
          }
          updateMarker(0);

          gsap.timeline({
            scrollTrigger: {
              trigger: root.querySelector('.usroute'),
              start: 'top 85%',
              end: 'bottom 45%',
              scrub: 0.8
            }
          })
          .fromTo(root.querySelector('.usroute__country--us'), { opacity: 0.35 }, { opacity: 1, duration: 0.1 }, 0)
          .to(marker, { opacity: 1, duration: 0.05 }, 0.02)
          .to(routePath, { strokeDashoffset: 0, ease: 'none', duration: 0.8 }, 0.05)
          .to(progressObj, {
            p: 1,
            ease: 'none',
            duration: 0.8,
            onUpdate: function () { updateMarker(progressObj.p); }
          }, 0.05)
          .fromTo(root.querySelector('.usroute__country--in'), { opacity: 0.35 }, { opacity: 1, duration: 0.1 }, 0.85)
          .fromTo(root.querySelector('.usroute__label--in'), { opacity: 0, y: 6 }, { opacity: 1, y: 0, duration: 0.1 }, 0.88);
        }

        // Doctor quote lights up word by word while scrolling
        var docQuote = root.querySelector('.doctor__quote');
        if (docQuote && typeof SplitText !== 'undefined') {
          var quoteSplit = SplitText.create(docQuote, { type: 'words' });
          gsap.fromTo(quoteSplit.words,
            { opacity: 0.2 },
            {
              opacity: 1,
              stagger: 0.04,
              ease: 'none',
              scrollTrigger: { trigger: docQuote, start: 'top 80%', end: 'bottom 55%', scrub: 0.5 }
            }
          );
        }

        var docImg = root.querySelector('.doctor__portrait img');
        if (docImg) {
          gsap.fromTo(docImg,
            { yPercent: -4, scale: 1.08 },
            {
              yPercent: 4,
              ease: 'none',
              scrollTrigger: { trigger: root.querySelector('.doctor'), start: 'top bottom', end: 'bottom top', scrub: true }
            }
          );
        }

        var docPlate = root.querySelector('.doctor__plate');
        if (docPlate) {
          gsap.fromTo(docPlate,
            { y: 30, rotate: 4, opacity: 0 },
            {
              y: 0,
              rotate: -2,
              opacity: 1,
              duration: 1,
              ease: 'back.out(1.6)',
              scrollTrigger: { trigger: root.querySelector('.doctor'), start: 'top 60%', once: true }
            }
          );
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeritageGSAP);
    } else {
      initHeritageGSAP();
    }

    document.addEventListener('shopify:section:load', function (e) {
      if (e.target.id === 'shopify-section-{{ section.id }}') {
        initHeritageGSAP();
      }
    });
  })();
</script>

{% stylesheet %}
  /* An odd stat count (e.g. a hidden stat) lets the last tile span the row. */
  .usin__stats > .stat:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .stat__subnote {
    display: block;
    margin-top: 4px;
    opacity: 0.7;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Brand Story & Doctor",
  "tag": "section",
  "class": "section-ellura-heritage",
  "settings": [
    {
      "type": "header",
      "content": "Story Card"
    },
    {
      "type": "text",
      "id": "story_eyebrow",
      "label": "Eyebrow text",
      "default": "From the US, for India"
    },
    {
      "type": "inline_richtext",
      "id": "story_heading",
      "label": "Heading",
      "default": "trusted in the US for 20+ years. <em>now in India.</em>"
    },
    {
      "type": "textarea",
      "id": "story_lead",
      "label": "Description text",
      "default": "Developed by Pharmatoka and trusted in the United States for more than two decades, ellura® now arrives in India — the same research-led approach to urinary tract health, in one capsule a day."
    },
    {
      "type": "color",
      "id": "story_bg",
      "label": "Story card background",
      "default": "#d0a6d8"
    },
    {
      "type": "header",
      "content": "Doctor Endorsement"
    },
    {
      "type": "checkbox",
      "id": "show_doctor",
      "label": "Show Doctor Card",
      "default": true
    },
    {
      "type": "text",
      "id": "doctor_eyebrow",
      "label": "Doctor eyebrow",
      "default": "RECOMMENDED BY UROLOGISTS"
    },
    {
      "type": "textarea",
      "id": "doctor_quote",
      "label": "Doctor quotation",
      "default": "“Urinary tract health is one of the most frustrating concerns my patients bring to me. Having a supplement backed by 20+ years of cranberry research and 36 mg of soluble, bioactive A-type PACs gives clinicians and patients a meaningful, non-antibiotic tool.”"
    },
    {
      "type": "text",
      "id": "doctor_link_text",
      "label": "CTA link label",
      "default": "Learn more about the science"
    },
    {
      "type": "url",
      "id": "doctor_link_url",
      "label": "CTA link URL"
    },
    {
      "type": "image_picker",
      "id": "doctor_image",
      "label": "Doctor Portrait Image"
    },
    {
      "type": "text",
      "id": "doctor_name",
      "label": "Doctor name",
      "default": "Dr. Bilal Chughtai, MD"
    },
    {
      "type": "text",
      "id": "doctor_role",
      "label": "Doctor title / credentials",
      "default": "Urologist · New York Presbyterian / Weill Cornell Medicine"
    },
    {
      "type": "color",
      "id": "doctor_bg",
      "label": "Doctor card background",
      "default": "#422343"
    },
    {
      "type": "header",
      "content": "Section Layout"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background color",
      "default": "transparent"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 6,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 6,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat Card",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Stat value / number",
          "default": "20"
        },
        {
          "type": "text",
          "id": "suffix",
          "label": "Suffix (+, %, mg)",
          "default": "+"
        },
        {
          "type": "select",
          "id": "suffix_size",
          "label": "Suffix size",
          "options": [
            { "value": "large", "label": "Same as number (e.g. +)" },
            { "value": "small", "label": "Small unit (e.g. mg)" }
          ],
          "default": "large"
        },
        {
          "type": "text",
          "id": "subnote",
          "label": "Small sub-text",
          "default": "years"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Stat label",
          "default": "Cranberry Research"
        },
        {
          "type": "select",
          "id": "color_theme",
          "label": "Card color theme",
          "options": [
            { "value": "butter", "label": "Butter (Yellow / Lilac-light)" },
            { "value": "blush", "label": "Blush (Soft pink)" },
            { "value": "peri", "label": "Periwinkle / Purple" },
            { "value": "sage", "label": "Sage" }
          ],
          "default": "butter"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand Story & Doctor",
      "blocks": [
        { "type": "stat", "settings": { "value": "20", "suffix": "+", "subnote": "years", "label": "Cranberry Research", "color_theme": "butter" } },
        { "type": "stat", "settings": { "value": "17", "suffix": "", "subnote": "", "label": "Clinical Studies", "color_theme": "blush" } },
        { "type": "stat", "settings": { "value": "36", "suffix": "mg", "suffix_size": "small", "subnote": "", "label": "Soluble A-type PACs per capsule", "color_theme": "sage" } }
      ]
    }
  ]
}
{% endschema %}

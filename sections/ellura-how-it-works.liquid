{% comment %}
  Section contract:
  ellura-how-it-works renders the 3-Step interactive mechanism of action
  with a pinned sticky biological bladder diagram on the left, animated bacteria and PAC particles,
  and synchronized scroll-triggered step cards on the right.
{% endcomment %}

<div
  id="how-it-works-{{ section.id }}"
  class="hiw section"
  style="--hiw-bg: {{ section.settings.bg_color }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background: var(--hiw-bg);"
  {{ section.shopify_attributes }}
>
  <div class="wrap hiw__grid">
    <!-- Left Sticky Visual Column -->
    <div class="hiw__visual">
      <div class="hiw__sticky">
        <svg
          viewBox="0 0 440 520"
          class="hiw__svg"
          role="img"
          aria-label="Diagram of the bladder: bacteria attach to the wall, PACs coat them, and they are flushed out through the urethra"
        >
          <defs>
            <radialGradient id="hiwGlow-{{ section.id }}" cx="50%" cy="55%" r="55%">
              <stop offset="0%" stop-color="#d0a6d8" stop-opacity="0.28" />
              <stop offset="100%" stop-color="#d0a6d8" stop-opacity="0" />
            </radialGradient>
          </defs>

          <!-- Bladder glow & background -->
          <ellipse cx="220" cy="280" rx="210" ry="220" fill="url(#hiwGlow-{{ section.id }})" />

          <!-- Ureters -->
          <path class="hiw__ureter" d="M52 12 C 70 70, 96 118, 124 152" />
          <path class="hiw__ureter" d="M388 12 C 370 70, 344 118, 316 152" />

          <!-- Bladder outline -->
          <path class="hiw__bladder" d="M112 150 C 58 176, 58 306, 132 362 C 172 394, 200 404, 205 432 L 205 518 L 235 518 L 235 432 C 240 404, 268 394, 308 362 C 382 306, 382 176, 328 150 C 288 132, 152 132, 112 150 Z" />

          <!-- Mucosal lining -->
          <path class="hiw__lining" d="M122 166 C 80 190, 80 298, 142 348 C 176 376, 204 386, 212 414 M 228 414 C 236 386, 264 376, 298 348 C 360 298, 360 190, 318 166 C 284 150, 156 150, 122 166" />
          <path class="hiw__wall-glow" d="M122 166 C 80 190, 80 298, 142 348 C 176 376, 204 386, 212 414 M 228 414 C 236 386, 264 376, 298 348 C 360 298, 360 190, 318 166" />

          <!-- Flushing Flow -->
          <path class="hiw__flow" d="M220 400 L 220 520" />
          <path class="hiw__flow" d="M212 380 L 212 520" style="animation-delay: 0.2s;" />
          <path class="hiw__flow" d="M228 380 L 228 520" />

          <!-- PAC Cloud Particles -->
          <g class="pac-cloud">
            <circle r="3.4" cx="150" cy="180" />
            <circle r="3.4" cx="170" cy="192" />
            <circle r="3.4" cx="190" cy="180" />
            <circle r="3.4" cx="210" cy="192" />
            <circle r="3.4" cx="230" cy="180" />
            <circle r="3.4" cx="250" cy="192" />
            <circle r="3.4" cx="270" cy="180" />
            <circle r="3.4" cx="290" cy="192" />
            <circle r="3.4" cx="150" cy="220" />
            <circle r="3.4" cx="170" cy="232" />
            <circle r="3.4" cx="190" cy="220" />
            <circle r="3.4" cx="210" cy="232" />
            <circle r="3.4" cx="230" cy="220" />
            <circle r="3.4" cx="250" cy="232" />
            <circle r="3.4" cx="270" cy="220" />
            <circle r="3.4" cx="290" cy="232" />
          </g>

          {% for i in (0..6) %}
            <g class="bac" data-i="{{ i }}">
              <g class="bac__pili">
                <line x1="0" y1="0" x2="15" y2="0" transform="rotate(0)" />
                <line x1="0" y1="0" x2="15" y2="0" transform="rotate(60)" />
                <line x1="0" y1="0" x2="15" y2="0" transform="rotate(120)" />
                <line x1="0" y1="0" x2="15" y2="0" transform="rotate(180)" />
                <line x1="0" y1="0" x2="15" y2="0" transform="rotate(240)" />
                <line x1="0" y1="0" x2="15" y2="0" transform="rotate(300)" />
              </g>
              <ellipse class="bac__body" rx="10" ry="6.5" />
              <g class="bac__pacs">
                <circle class="pac" r="3.4" cx="14" cy="0" />
                <circle class="pac" r="3.4" cx="-7" cy="9.52" />
                <circle class="pac" r="3.4" cx="-7" cy="-9.52" />
              </g>
            </g>
          {% endfor %}

          <!-- Labels -->
          <g class="hiw__labels">
            <text x="20" y="120">Bladder</text>
            <path d="M72 126 L 104 150" />
            <text x="330" y="420">Urinary</text>
            <text x="330" y="436">tract wall</text>
            <path d="M340 404 L 322 330" />
          </g>
        </svg>

        <ul class="hiw__legend t-mono" role="list">
          <li>
            <i class="hiw__key hiw__key--bac"></i>
            <span>{{ section.settings.legend_bacteria | default: 'Bacteria' }}</span>
          </li>
          <li>
            <i class="hiw__key hiw__key--pac"></i>
            <span>{{ section.settings.legend_pac | default: 'Soluble A-type PACs' }}</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Right Content / Steps Column -->
    <div class="hiw__content">
      <header class="hiw__head">
        {% if section.settings.eyebrow != blank %}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        <h2 id="hiw-title-{{ section.id }}" class="t-d2 accent-em">
          {{ section.settings.heading }}
        </h2>
      </header>

      <ol class="hiw__steps" role="list">
        {% for block in section.blocks %}
          {% if block.type == 'step' %}
            <li class="hiw__step {% if forloop.first %}is-active{% endif %}" {{ block.shopify_attributes }}>
              <span class="hiw__n t-mono">Step {{ block.settings.step_number | escape }}</span>
              <h3 class="t-d3">{{ block.settings.title }}</h3>
              <p class="t-lead">{{ block.settings.description }}</p>
            </li>
          {% endif %}
        {% endfor %}
      </ol>
    </div>
  </div>
</div>

<script>
  (function () {
    function initHIWGSAP() {
      if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;
      var root = document.getElementById('how-it-works-{{ section.id }}');
      if (!root) return;

      var steps = root.querySelectorAll('.hiw__step');
      var bacteria = root.querySelectorAll('.bac');

      function setActiveStep(idx) {
        steps.forEach(function (s, i) {
          s.classList.toggle('is-active', i === idx);
        });
      }

      var qi = [
        { x: 128, y: 250, r: -70 },
        { x: 142, y: 318, r: -45 },
        { x: 190, y: 372, r: -12 },
        { x: 262, y: 362, r: 20 },
        { x: 308, y: 300, r: 50 },
        { x: 318, y: 226, r: 78 },
        { x: 158, y: 188, r: -100 }
      ];

      bacteria.forEach(function (c, L) {
        gsap.set(c, {
          x: 220 + (L % 3 - 1) * 8,
          y: 560 + L * 26,
          rotation: qi[L].r,
          opacity: 0
        });
      });
      gsap.set(root.querySelectorAll('.bac__pacs .pac'), { scale: 0, transformOrigin: 'center' });

      var tl = gsap.timeline({ paused: true, defaults: { ease: 'power2.inOut' } });
      tl.addLabel('s0');
      bacteria.forEach(function (c, L) {
        tl.to(c, { opacity: 1, duration: 0.05 }, L * 0.05)
          .to(c, {
            keyframes: [
              { x: 220, y: 450, duration: 0.35 },
              { x: qi[L].x, y: qi[L].y, duration: 0.45 }
            ]
          }, L * 0.05);
      });
      tl.fromTo(root.querySelectorAll('.bac__pili'), { scale: 0.5, transformOrigin: 'center' }, { scale: 1, duration: 0.2 }, 0.75)
        .to(root.querySelector('.hiw__wall-glow'), { opacity: 1, duration: 0.25 }, 0.8)
        .addLabel('s1', 1.1)
        .fromTo(root.querySelectorAll('.pac-cloud circle'), { opacity: 0, y: -120 }, { opacity: 1, y: 0, stagger: 0.02, duration: 0.35 }, 's1')
        .to(root.querySelector('.pac-cloud'), { opacity: 0, duration: 0.2 }, 's1+=0.45')
        .to(root.querySelectorAll('.bac__pacs .pac'), { scale: 1, stagger: 0.012, duration: 0.3, ease: 'back.out(2)' }, 's1+=0.35')
        .to(root.querySelectorAll('.bac__pili'), { scale: 0.25, duration: 0.3 }, 's1+=0.5')
        .to(root.querySelector('.hiw__wall-glow'), { opacity: 0, duration: 0.3 }, 's1+=0.5');

      bacteria.forEach(function (c, L) {
        tl.to(c, {
          x: 220 + (qi[L].x - 220) * 0.55,
          y: qi[L].y + (290 - qi[L].y) * 0.35,
          rotation: '+=40',
          duration: 0.4
        }, 's1+=' + (0.55 + L * 0.02));
      });

      tl.addLabel('s2', '>+0.1')
        .fromTo(root.querySelectorAll('.hiw__flow'), { strokeDashoffset: 120, opacity: 0 }, { strokeDashoffset: 0, opacity: 1, duration: 0.8, ease: 'none' }, 's2');

      bacteria.forEach(function (c, L) {
        tl.to(c, {
          keyframes: [
            { x: 220 + (L % 3 - 1) * 6, y: 440, duration: 0.3 },
            { y: 600, opacity: 0.2, duration: 0.35 }
          ]
        }, 's2+=' + (L * 0.05));
      });
      tl.addLabel('s3');

      var mm = gsap.matchMedia();
      mm.add('(prefers-reduced-motion: no-preference)', function () {
        ScrollTrigger.create({
          trigger: root.querySelector('.hiw__steps'),
          start: 'top 70%',
          end: 'bottom 60%',
          scrub: 0.8,
          animation: tl
        });

        steps.forEach(function (stepEl, idx) {
          ScrollTrigger.create({
            trigger: stepEl,
            start: 'top 62%',
            end: 'bottom 62%',
            onToggle: function (self) {
              if (self.isActive) setActiveStep(idx);
            }
          });
        });
        setActiveStep(0);
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHIWGSAP);
    } else {
      initHIWGSAP();
    }

    document.addEventListener('shopify:section:load', function (e) {
      if (e.target.id === 'shopify-section-{{ section.id }}') {
        initHIWGSAP();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "How It Works Mechanism",
  "tag": "section",
  "class": "section-ellura-hiw",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "The mechanism"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "how <span class='brand-word'>ellura</span> <em>works</em>"
    },
    {
      "type": "text",
      "id": "legend_bacteria",
      "label": "Legend label: Bacteria",
      "default": "Bacteria"
    },
    {
      "type": "text",
      "id": "legend_pac",
      "label": "Legend label: PACs",
      "default": "Soluble A-type PACs"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#5a2e58"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Padding bottom",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Mechanism Step",
      "settings": [
        {
          "type": "text",
          "id": "step_number",
          "label": "Step number (01, 02, 03)",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Step title",
          "default": "Bacteria enter, attach, and multiply"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Step description",
          "default": "Bacteria migrate to the urinary tract, leading to disruption of urinary tract balance."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "How It Works Mechanism",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "step_number": "01",
            "title": "Bacteria enter, attach, and multiply",
            "description": "Bacteria migrate to the urinary tract, leading to disruption of urinary tract balance."
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "02",
            "title": "ellura may help reduce bacterial adhesion",
            "description": "36 mg PACs in ellura may reduce certain bacteria from adhering to the bladder wall."
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "03",
            "title": "Bacteria are flushed out",
            "description": "Without attachment, bacteria are naturally eliminated through urine."
          }
        }
      ]
    }
  ]
}
{% endschema %}

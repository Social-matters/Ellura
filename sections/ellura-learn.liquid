{% comment %}
  Section contract:
  ellura-learn renders the Educational Knowledge Hub Bento Grid:
  - Left large featured article card with hover zoom & dark gradient overlay
  - Right stacked educational cards with color themes and masked background visuals
{% endcomment %}

<div
  id="learn-{{ section.id }}"
  class="learn-t section"
  style="--learn-bg: {{ section.settings.bg_color }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background: var(--learn-bg);"
  {{ section.shopify_attributes }}
>
  <div class="wrap">
    <div class="learn-t__head">
      <h2 id="learn-t-title-{{ section.id }}" class="t-d2 accent-em" data-gsap="fade-up">
        {{ section.settings.heading }}
      </h2>
      {% if section.settings.view_all_label != blank %}
        <a href="{{ section.settings.view_all_url | default: '/blogs/news' }}" class="text-link learn-t__all" data-gsap="fade-up">
          {{ section.settings.view_all_label | escape }}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      {% endif %}
    </div>

    <div class="bento" data-gsap="stagger">
      <!-- Feature Card (Spans 3 Rows on Desktop) -->
      {% if section.settings.featured_title != blank %}
        <a href="{{ section.settings.featured_url | default: '/blogs/news' }}" class="bento__feature">
          {% if section.settings.featured_image != blank %}
            <img
              src="{{ section.settings.featured_image | image_url: width: 1400 }}"
              alt="{{ section.settings.featured_title | escape }}"
              width="700"
              height="600"
              loading="lazy"
            >
          {% else %}
            <img
              src="{{ 'cranberry-cut-800.webp' | asset_url }}"
              alt="{{ section.settings.featured_title | escape }}"
              width="700"
              height="600"
              loading="lazy"
            >
          {% endif %}
          <span class="chip">{{ section.settings.featured_badge | default: 'Featured article' }}</span>
          <h3 class="t-d3">{{ section.settings.featured_title | escape }}</h3>
          <span class="bento__read">
            {{ section.settings.featured_read_label | default: 'Read more' }}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </a>
      {% endif %}

      <!-- Secondary Stacked Articles -->
      {% for block in section.blocks %}
        {% if block.type == 'article_item' %}
          <a
            href="{{ block.settings.url | default: '/blogs/news' }}"
            class="bento__item bento__item--{{ block.settings.card_theme }}"
            {{ block.shopify_attributes }}
          >
            <span class="chip chip--solid">{{ block.settings.topic | escape }}</span>
            <h3 class="t-h4">{{ block.settings.title | escape }}</h3>
            <span class="bento__meta">{{ block.settings.meta | escape }}</span>
            {% if block.settings.image != blank %}
              <img src="{{ block.settings.image | image_url: width: 600 }}" alt="" width="300" height="240" loading="lazy">
            {% else %}
              {% assign preset_img = block.settings.preset_photo | append: '-800.webp' %}
              <img src="{{ preset_img | asset_url }}" alt="" width="300" height="240" loading="lazy">
            {% endif %}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Educational Bento Grid",
  "tag": "section",
  "class": "section-ellura-learn",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Section heading",
      "default": "know your body. <em>know the science.</em>"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all link text",
      "default": "View all articles"
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "View all link URL"
    },
    {
      "type": "header",
      "content": "Featured Article (Large Card)"
    },
    {
      "type": "text",
      "id": "featured_badge",
      "label": "Featured badge",
      "default": "Featured article"
    },
    {
      "type": "text",
      "id": "featured_title",
      "label": "Featured article title",
      "default": "Cranberry PACs vs. D-mannose: which better supports urinary tract health?"
    },
    {
      "type": "image_picker",
      "id": "featured_image",
      "label": "Featured image override"
    },
    {
      "type": "text",
      "id": "featured_read_label",
      "label": "Read more button text",
      "default": "Read more"
    },
    {
      "type": "url",
      "id": "featured_url",
      "label": "Featured article URL"
    },
    {
      "type": "header",
      "content": "Section Layout"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background color",
      "default": "transparent"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "article_item",
      "name": "Bento Article",
      "settings": [
        {
          "type": "text",
          "id": "topic",
          "label": "Topic tag",
          "default": "Science"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Article title",
          "default": "UTIs, antibiotic resistance and prevention strategies"
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Reading time & date",
          "default": "5 min read · September 2026"
        },
        {
          "type": "select",
          "id": "card_theme",
          "label": "Card color theme",
          "options": [
            { "value": "lilac", "label": "Lilac (Soft purple)" },
            { "value": "butter", "label": "Butter (Warm yellow)" },
            { "value": "blush", "label": "Blush (Soft pink)" }
          ],
          "default": "lilac"
        },
        {
          "type": "select",
          "id": "preset_photo",
          "label": "Preset Graphic Photo",
          "options": [
            { "value": "lab-scientist", "label": "Laboratory Scientist" },
            { "value": "lab-pipette", "label": "Laboratory Pipette" },
            { "value": "berries-dark", "label": "Cranberry Berries" }
          ],
          "default": "lab-scientist"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image override"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Article link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Educational Bento Grid",
      "blocks": [
        {
          "type": "article_item",
          "settings": {
            "topic": "Microbiome",
            "title": "UTIs, antibiotic resistance and prevention strategies",
            "meta": "5 min read · September 2026",
            "card_theme": "lilac",
            "preset_photo": "lab-scientist"
          }
        },
        {
          "type": "article_item",
          "settings": {
            "topic": "Clinical Research",
            "title": "Why 36 mg of soluble PACs is the clinical gold standard",
            "meta": "6 min read · August 2026",
            "card_theme": "butter",
            "preset_photo": "lab-pipette"
          }
        },
        {
          "type": "article_item",
          "settings": {
            "topic": "Ingredients",
            "title": "Juice vs Pomace: the truth about cranberry extracts",
            "meta": "4 min read · July 2026",
            "card_theme": "blush",
            "preset_photo": "berries-dark"
          }
        }
      ]
    }
  ]
}
{% endschema %}

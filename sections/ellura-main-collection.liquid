{% comment %}
  Section contract.
  ellura-main-collection renders the shop grid (reference Shop): the collection's products as
  ellura product cards, followed by the Subscribe & Save band.
  @example
  <!-- collection template, below the page hero -->
{% endcomment %}
<div class="section section--tight" id="shop-{{ section.id }}" aria-labelledby="shop-title-{{ section.id }}">
  <h2 id="shop-title-{{ section.id }}" class="sr-only">{{ collection.title | escape }}</h2>
  <div class="wrap">
    {%- paginate collection.products by section.settings.per_page -%}
      {%- if collection.products.size > 0 -%}
        <ul class="shop-grid" role="list" data-stagger>
          {%- for product in collection.products -%}
            <li>{% render 'ellura-product-card', product: product, index: forloop.index0, priority: forloop.first %}</li>
          {%- endfor -%}
        </ul>
        {%- if paginate.pages > 1 -%}
          <nav class="crumbs" aria-label="Pagination" style="justify-content: center; margin-top: 32px;">
            {{ paginate | default_pagination }}
          </nav>
        {%- endif -%}
      {%- else -%}
        <div class="rv__empty" data-fade>
          {% render 'ellura-icon', name: 'bag', px: 30 %}
          <p class="t-h4">No products here yet.</p>
          <p class="muted">Check back soon — new packs are on the way.</p>
        </div>
      {%- endif -%}
    {%- endpaginate -%}

    {%- if section.settings.show_subband -%}
      <aside class="subband" data-fade>
        <div>
          {%- if section.settings.sub_eyebrow != blank -%}<p class="eyebrow">{{ section.settings.sub_eyebrow | escape }}</p>{%- endif -%}
          <h2 class="t-d2">{{ section.settings.sub_heading }}</h2>
          {%- if section.settings.sub_lead != blank -%}<p class="t-lead">{{ section.settings.sub_lead }}</p>{%- endif -%}
        </div>
        <div class="subband__cta">
          {%- if section.settings.sub_btn_label != blank -%}
            <a href="{{ section.settings.sub_btn_link | default: '/pages/subscribe' }}" class="btn btn--lg btn--white">
              {{ section.settings.sub_btn_label | escape }} {% render 'ellura-icon', name: 'arrow' %}
            </a>
          {%- endif -%}
          {%- if section.settings.sub_note != blank -%}<p class="t-xs">{{ section.settings.sub_note | escape }}</p>{%- endif -%}
        </div>
      </aside>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Shop grid",
  "tag": "section",
  "class": "section-ellura-main-collection",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 3, "max": 24, "step": 3, "default": 12 },
    { "type": "header", "content": "Subscribe & Save band" },
    { "type": "checkbox", "id": "show_subband", "label": "Show band", "default": true },
    { "type": "text", "id": "sub_eyebrow", "label": "Eyebrow", "default": "Subscribe & Save" },
    { "type": "inline_richtext", "id": "sub_heading", "label": "Heading", "default": "subscribe once. <em>save 10% every time.</em>" },
    { "type": "inline_richtext", "id": "sub_lead", "label": "Text", "default": "Deliveries arrive on your schedule with free shipping. Skip, pause or cancel anytime from your account." },
    { "type": "text", "id": "sub_btn_label", "label": "Button label", "default": "How it works" },
    { "type": "url", "id": "sub_btn_link", "label": "Button link" },
    { "type": "text", "id": "sub_note", "label": "Note", "default": "The 180-capsule bundle is one-time purchase only." }
  ]
}
{% endschema %}

{% comment %}
  Section contract.
  ellura-main-product renders the product page top (reference Product): breadcrumbs, a
  clip-reveal image gallery and the buy box with pack links, variants, one-time or
  Subscribe & Save selling plans, quantity and add to cart, plus trust and highlight blocks and
  a sticky buy bar. The form posts natively; JavaScript only enhances prices, quantity and gallery.
  @example
  <!-- product template, first section -->
{% endcomment %}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign form_id = 'product-form-' | append: section.id
  assign notify_id = 'notify-' | append: section.id
  assign has_plans = false
  if product.selling_plan_groups.size > 0
    assign has_plans = true
    assign first_plan = product.selling_plan_groups.first.selling_plans.first
  endif
  assign default_sub = false
  if has_plans and section.settings.default_subscribe
    assign default_sub = true
  endif
  if product.requires_selling_plan
    assign default_sub = true
  endif
  assign images = product.media | where: 'media_type', 'image'
  assign tones = 'blush,lilac,butter' | split: ','
  assign tone = tones[0]
  for p in section.settings.pack_products
    if p.id == product.id
      assign t = forloop.index0 | modulo: 3
      assign tone = tones[t]
    endif
  endfor
-%}
  {%- comment -%} Short pack label ("30 capsules") and supply ("1-month") like the reference. {%- endcomment -%}
  {%- capture pack_label -%}{% render 'ellura-pack-label', product: product %}{%- endcapture -%}
  {%- capture pack_supply -%}{% render 'ellura-pack-label', product: product, part: 'supply' %}{%- endcapture -%}
<div class="pdp" id="pdp-{{ section.id }}" data-currency="{{ cart.currency.iso_code }}" data-locale="{{ request.locale.iso_code }}">
  <div class="wrap">
    <div class="pdp__crumbs">
      {% render 'ellura-crumbs', parent_label: section.settings.crumb_parent, parent_url: routes.all_products_collection_url, current: pack_label %}
    </div>
    <div class="pdp__top">
      {%- comment -%} Gallery {%- endcomment -%}
      <div class="gallery pcard--{{ tone }}" aria-roledescription="carousel" aria-label="Product images" data-gallery>
        {%- if images.size > 1 -%}
          <ul class="gallery__thumbs" role="list">
            {%- for media in images -%}
              <li>
                <button type="button" class="gallery__thumb" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="Show image {{ forloop.index }} of {{ images.size }}" data-gallery-go="{{ forloop.index0 }}">
                  {{ media.preview_image | image_url: width: 168 | image_tag: alt: '', width: 84, height: 84, loading: 'lazy' }}
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        <div>
          <div class="gallery__stage" tabindex="0" aria-label="Image 1 of {{ images.size }}. Use arrow keys to browse." data-gallery-stage>
            {%- for media in images -%}
              <div class="gallery__slide{% if forloop.first %} is-current{% if section.settings.tint_first_image %} is-pack{% endif %}{% endif %}" role="group" aria-roledescription="slide" aria-hidden="{% unless forloop.first %}true{% else %}false{% endunless %}"{% unless forloop.first %} style="opacity: 0; visibility: hidden;"{% endunless %}>
                {%- liquid
                  assign slide_loading = 'lazy'
                  assign slide_priority = 'auto'
                  if forloop.first
                    assign slide_loading = 'eager'
                    assign slide_priority = 'high'
                  endif
                -%}
                {{ media.preview_image | image_url: width: 1400 | image_tag: widths: '500, 800, 1100, 1400', sizes: '(max-width: 900px) 100vw, 50vw', alt: media.alt, loading: slide_loading, fetchpriority: slide_priority, draggable: 'false' }}
              </div>
            {%- else -%}
              <div class="gallery__slide is-current">{{ 'product-1' | placeholder_svg_tag }}</div>
            {%- endfor -%}
            {%- if images.size > 1 -%}
              <span class="gallery__count" aria-hidden="true" data-gallery-count>01 / {{ images.size | prepend: '0' | slice: -2, 2 }}</span>
              <div class="gallery__nav">
                <button type="button" aria-label="Previous image" data-gallery-step="-1">{% render 'ellura-icon', name: 'chevronLeft', px: 20 %}</button>
                <button type="button" aria-label="Next image" data-gallery-step="1">{% render 'ellura-icon', name: 'chevronRight', px: 20 %}</button>
              </div>
            {%- endif -%}
          </div>
          {%- if images.size > 1 -%}
            <div class="gallery__dots" style="margin-top: 14px;">
              {%- for media in images -%}
                <button type="button" aria-label="Image {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" data-gallery-go="{{ forloop.index0 }}"></button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Buy box {%- endcomment -%}
      <div class="buy" id="buy">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="t-mono muted" style="margin-bottom: 10px;">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          <h1 class="buy__title">
            {%- if section.settings.title_override != blank -%}{{ section.settings.title_override | replace_first: 'ellura®', '<span class="brand-word">ellura®</span>' }}{%- else -%}{{ product.title | escape }}{%- endif -%}
          </h1>
        </div>

        {%- if section.settings.rating != blank -%}
          <div class="buy__rating">
            {%- assign rating_value = section.settings.rating | plus: 0 -%}
            {% render 'ellura-stars', value: rating_value, label: section.settings.rating_text %}
            <a href="#reviews">{{ section.settings.rating }} · {{ section.settings.rating_text | escape }}</a>
          </div>
        {%- endif -%}

        <div class="buy__desc">
          {%- if section.settings.description != blank -%}{{ section.settings.description }}{%- else -%}{{ product.description }}{%- endif -%}
        </div>

        <div class="buy__pricewrap">
          <p class="price price--lg" data-price-box>
            <span class="sr-only">Price</span>
            <span class="price__now" data-price-now>
              {%- if default_sub -%}{{ variant.selling_plan_allocations.first.price | money_without_trailing_zeros }}{%- else -%}{{ variant.price | money_without_trailing_zeros }}{%- endif -%}
            </span>
            {%- liquid
              assign mrp = variant.price
              if variant.compare_at_price > variant.price
                assign mrp = variant.compare_at_price
              endif
              assign now_price = variant.price
              if default_sub
                assign now_price = variant.selling_plan_allocations.first.price
              endif
              assign saving = mrp | minus: now_price
            -%}
            <span class="sr-only">, MRP</span>
            <s class="price__was" data-price-was{% unless saving > 0 %} hidden{% endunless %}>{{ mrp | money_without_trailing_zeros }}</s>
            <span class="chip chip--save price__save" data-price-save{% unless saving > 0 %} hidden{% endunless %}>Save {{ saving | money_without_trailing_zeros }}</span>
          </p>
          <p class="buy__tax">{{ section.settings.tax_note | escape }}<span data-tax-sub{% unless default_sub %} hidden{% endunless %}> · subscription price shown</span></p>
        </div>

        {%- if section.settings.pack_products.size > 1 -%}
          <div>
            <p class="buy__label" id="pack-label-{{ section.id }}">Pack size{% if pack_supply != blank %} <span>{{ pack_supply }} supply</span>{% endif %}</p>
            <div class="packs-select" role="list" aria-labelledby="pack-label-{{ section.id }}">
              {%- for pack in section.settings.pack_products -%}
                <a href="{{ pack.url }}" class="pack-opt" role="listitem"{% if pack.id == product.id %} aria-current="page" aria-checked="true"{% else %} aria-checked="false"{% endif %}>
                  {%- capture opt_label -%}{% render 'ellura-pack-label', product: pack %}{%- endcapture -%}
                  {%- capture opt_supply -%}{% render 'ellura-pack-label', product: pack, part: 'supply' %}{%- endcapture -%}
                  <strong>{{ opt_label }}</strong>
                  {%- if opt_supply != blank -%}<span>{{ opt_supply }}</span>{%- endif -%}
                  <em>{% if pack.available %}{{ pack.price | money_without_trailing_zeros }}{% else %}At launch{% endif %}</em>
                </a>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- if product.available -%}
          {%- form 'product', product, id: form_id -%}
            {%- unless product.has_only_default_variant -%}
              <fieldset class="purchase" style="border: 0; padding: 0; margin: 0 0 18px;">
                <legend class="buy__label">{{ product.options.first | escape }}</legend>
                <div class="packs-select">
                  {%- for v in product.variants -%}
                    <label class="pack-opt"{% unless v.available %} aria-disabled="true"{% endunless %}>
                      <input
                        type="radio"
                        name="id"
                        value="{{ v.id }}"
                        class="sr-only"
                        {% if v.id == variant.id %}checked{% endif %}
                        {% unless v.available %}disabled{% endunless %}
                        data-price="{{ v.price }}"
                        data-compare="{{ v.compare_at_price | default: 0 }}"
                        data-sub-price="{{ v.selling_plan_allocations.first.price | default: v.price }}"
                      >
                      <strong>{{ v.title | escape }}</strong>
                      <em>{% if v.available %}{{ v.price | money_without_trailing_zeros }}{% else %}Sold out{% endif %}</em>
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- else -%}
              <input type="hidden" name="id" value="{{ variant.id }}" data-price="{{ variant.price }}" data-compare="{{ variant.compare_at_price | default: 0 }}" data-sub-price="{{ variant.selling_plan_allocations.first.price | default: variant.price }}">
            {%- endunless -%}

            {%- if has_plans -%}
              <fieldset class="purchase" style="border: 0; padding: 0; margin: 0;">
                <legend class="buy__label">Purchase option</legend>
                {%- unless product.requires_selling_plan -%}
                  <label class="popt{% unless default_sub %} is-checked{% endunless %}">
                    <input type="radio" name="selling_plan" value=""{% unless default_sub %} checked{% endunless %}>
                    <span class="popt__dot" aria-hidden="true"></span>
                    <span class="popt__title">One-time purchase</span>
                    <span class="popt__price" data-popt-once>{{ variant.price | money_without_trailing_zeros }}</span>
                  </label>
                {%- endunless -%}
                <label class="popt{% if default_sub %} is-checked{% endif %}">
                  <input type="radio" name="selling_plan" value="{{ first_plan.id }}"{% if default_sub %} checked{% endif %}>
                  <span class="popt__dot" aria-hidden="true"></span>
                  <span class="popt__title">{{ section.settings.sub_label | escape }}</span>
                  <span class="popt__price">
                    <span data-popt-sub>{{ variant.selling_plan_allocations.first.price | money_without_trailing_zeros }}</span>
                    <s>{{ variant.price | money_without_trailing_zeros }}</s>
                  </span>
                  <span class="popt__note">
                    <span>{% render 'ellura-icon', name: 'truck', px: 14 %} Free shipping</span>
                    <span>{% render 'ellura-icon', name: 'pause', px: 14 %} Pause or cancel anytime</span>
                    <span>{% render 'ellura-icon', name: 'repeat', px: 14 %} {{ first_plan.name | escape }}</span>
                  </span>
                </label>
              </fieldset>
            {%- endif -%}

            <div class="buy__actions">
              <div class="qty qty--md" role="group" aria-label="Quantity">
                <button type="button" class="qty__btn" aria-label="Decrease quantity" data-qty-step="-1">{% render 'ellura-icon', name: 'minus', px: 16 %}</button>
                <label for="{{ form_id }}-qty" class="sr-only">Quantity</label>
                <input id="{{ form_id }}-qty" class="qty__value" type="number" name="quantity" value="1" min="1" max="10" inputmode="numeric" style="width: 3ch; border: 0; background: none; text-align: center; font: inherit;">
                <button type="button" class="qty__btn" aria-label="Increase quantity" data-qty-step="1">{% render 'ellura-icon', name: 'plus', px: 16 %}</button>
              </div>
              <button type="submit" class="btn btn--lg" data-add-button>
                {% render 'ellura-icon', name: 'bag' %} Add to cart · <span data-add-total>{%- if default_sub -%}{{ variant.selling_plan_allocations.first.price | money_without_trailing_zeros }}{%- else -%}{{ variant.price | money_without_trailing_zeros }}{%- endif -%}</span>
              </button>
            </div>
          {%- endform -%}
        {%- else -%}
          <div class="notify">
            <p><strong>{{ product.title | escape }} is coming soon.</strong> {{ section.settings.notify_text | escape }}</p>
            {%- form 'customer', id: notify_id -%}
              <input type="hidden" name="contact[tags]" value="notify-me,{{ product.handle }}">
              {%- if form.posted_successfully? -%}
                <div class="note note--success" role="status">{% render 'ellura-icon', name: 'check', px: 18 %}<div>Thanks — we’ll email you when it’s available.</div></div>
              {%- else -%}
                <label class="sr-only" for="notify-email-{{ section.id }}">Email address</label>
                <input id="notify-email-{{ section.id }}" name="contact[email]" type="email" class="input" placeholder="you@example.com" autocomplete="email" required>
                <button class="btn" type="submit">Notify me</button>
              {%- endif -%}
            {%- endform -%}
          </div>
        {%- endif -%}

        {%- assign trust_blocks = section.blocks | where: 'type', 'trust' -%}
        {%- if trust_blocks.size > 0 -%}
          <ul class="buy__trust" role="list">
            {%- for block in trust_blocks -%}
              <li {{ block.shopify_attributes }}>{% render 'ellura-icon', name: block.settings.icon %} {{ block.settings.text | escape }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- assign highlight_blocks = section.blocks | where: 'type', 'highlight' -%}
        {%- if highlight_blocks.size > 0 -%}
          <ul class="buy__highlights" role="list">
            {%- for block in highlight_blocks -%}
              <li {{ block.shopify_attributes }}>
                {% render 'ellura-icon', name: 'check', px: 18 %}
                <span><strong>{{ block.settings.title | escape }}</strong>{{ block.settings.body }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{%- if product.available and section.settings.show_buybar -%}
  <div class="buybar" aria-hidden="true" data-buybar>
    <div class="wrap buybar__inner">
      {%- if product.featured_image -%}
        {{ product.featured_image | image_url: width: 96 | image_tag: class: 'buybar__img', alt: '', width: 48, height: 48, loading: 'lazy' }}
      {%- endif -%}
      <div class="buybar__info">
        <strong>{{ product.title | escape }}</strong>
        <span data-buybar-price>{{ variant.price | money_without_trailing_zeros }}</span>
      </div>
      <button type="submit" form="{{ form_id }}" class="btn" tabindex="-1">{% render 'ellura-icon', name: 'bag' %} Add to cart</button>
    </div>
  </div>
{%- endif -%}

<script>
  (function () {
    var root = document.getElementById('pdp-{{ section.id }}');
    if (!root) return;
    var form = document.getElementById('{{ form_id }}');
    var money = new Intl.NumberFormat(root.dataset.locale || undefined, {
      style: 'currency',
      currency: root.dataset.currency || 'INR',
      maximumFractionDigits: 0
    });
    var fmt = function (cents) { return money.format((Number(cents) || 0) / 100); };

    /* Price display follows the selected variant, purchase option and quantity. */
    function selectedVariantInput() {
      return form.querySelector('input[name="id"]:checked') || form.querySelector('input[name="id"]');
    }
    function updatePrices() {
      if (!form) return;
      var v = selectedVariantInput();
      if (!v) return;
      var planInput = form.querySelector('input[name="selling_plan"]:checked');
      var subscribing = !!(planInput && planInput.value);
      var unit = Number(subscribing ? v.dataset.subPrice : v.dataset.price);
      var was = Math.max(Number(v.dataset.price), Number(v.dataset.compare) || 0);
      var qtyInput = form.querySelector('input[name="quantity"]');
      var qty = Math.max(1, parseInt(qtyInput && qtyInput.value, 10) || 1);
      root.querySelector('[data-price-now]').textContent = fmt(unit);
      var wasEl = root.querySelector('[data-price-was]');
      wasEl.hidden = !(was > unit);
      wasEl.textContent = fmt(was);
      var saveEl = root.querySelector('[data-price-save]');
      if (saveEl) {
        saveEl.hidden = !(was > unit);
        saveEl.textContent = 'Save ' + fmt(was - unit);
      }
      var taxSub = root.querySelector('[data-tax-sub]');
      if (taxSub) taxSub.hidden = !subscribing;
      var total = root.querySelector('[data-add-total]');
      if (total) total.textContent = fmt(unit * qty);
      var once = root.querySelector('[data-popt-once]');
      if (once) once.textContent = fmt(v.dataset.price);
      var sub = root.querySelector('[data-popt-sub]');
      if (sub) sub.textContent = fmt(v.dataset.subPrice);
      var barPrice = document.querySelector('[data-buybar-price]');
      if (barPrice) barPrice.textContent = fmt(unit) + (subscribing ? ' with Subscribe & Save' : '');
      form.querySelectorAll('.popt').forEach(function (label) {
        var input = label.querySelector('input');
        label.classList.toggle('is-checked', !!(input && input.checked));
      });
      if (v.type === 'radio') {
        var url = new URL(window.location.href);
        url.searchParams.set('variant', v.value);
        history.replaceState(history.state, '', url);
      }
    }

    if (form) {
      form.addEventListener('change', updatePrices);
      form.querySelectorAll('[data-qty-step]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var input = form.querySelector('input[name="quantity"]');
          var next = (parseInt(input.value, 10) || 1) + Number(btn.dataset.qtyStep);
          input.value = Math.min(Number(input.max) || 10, Math.max(1, next));
          updatePrices();
        });
      });
      form.querySelector('input[name="quantity"]').addEventListener('input', updatePrices);
    }

    /* Gallery: clip-reveal between slides (reference product gallery). */
    var slides = Array.prototype.slice.call(root.querySelectorAll('.gallery__slide'));
    var current = 0;
    var count = root.querySelector('[data-gallery-count]');
    var pad = function (n) { return String(n).padStart(2, '0'); };
    function go(index) {
      if (slides.length < 2) return;
      var next = (index % slides.length + slides.length) % slides.length;
      if (next === current) return;
      var dir = next > current || (current === slides.length - 1 && next === 0) ? 1 : -1;
      var from = slides[current];
      var to = slides[next];
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches || typeof gsap === 'undefined';
      slides.forEach(function (s, i) {
        s.classList.toggle('is-current', i === next);
        s.setAttribute('aria-hidden', String(i !== next));
        s.style.zIndex = i === next ? 2 : i === current ? 1 : 0;
      });
      to.style.visibility = 'visible';
      to.style.opacity = 1;
      if (reduce) {
        from.style.visibility = 'hidden';
        from.style.opacity = 0;
      } else {
        gsap.fromTo(to, { clipPath: dir > 0 ? 'inset(0% 0% 0% 100%)' : 'inset(0% 100% 0% 0%)' }, {
          clipPath: 'inset(0% 0% 0% 0%)', duration: 0.8, ease: 'expo.out',
          onComplete: function () { from.style.visibility = 'hidden'; from.style.opacity = 0; }
        });
        gsap.fromTo(to.querySelector('img'), { scale: 1.12, xPercent: dir * 6 }, { scale: 1, xPercent: 0, duration: 1.1, ease: 'expo.out' });
        gsap.to(from.querySelector('img'), { xPercent: -dir * 10, duration: 0.8, ease: 'expo.out', onComplete: function () { gsap.set(from.querySelector('img'), { xPercent: 0 }); } });
      }
      current = next;
      root.querySelectorAll('[data-gallery-go]').forEach(function (b) {
        b.setAttribute('aria-current', String(Number(b.dataset.galleryGo) === current));
      });
      if (count) count.textContent = pad(current + 1) + ' / ' + pad(slides.length);
      var stage = root.querySelector('[data-gallery-stage]');
      stage.setAttribute('aria-label', 'Image ' + (current + 1) + ' of ' + slides.length + '. Use arrow keys to browse.');
    }
    root.querySelectorAll('[data-gallery-go]').forEach(function (b) {
      b.addEventListener('click', function () { go(Number(b.dataset.galleryGo)); });
    });
    root.querySelectorAll('[data-gallery-step]').forEach(function (b) {
      b.addEventListener('click', function () { go(current + Number(b.dataset.galleryStep)); });
    });
    var stage = root.querySelector('[data-gallery-stage]');
    if (stage) {
      stage.addEventListener('keydown', function (e) {
        if (e.key === 'ArrowRight') go(current + 1);
        if (e.key === 'ArrowLeft') go(current - 1);
      });
      var start = null;
      stage.addEventListener('pointerdown', function (e) { start = { x: e.clientX, y: e.clientY }; });
      stage.addEventListener('pointerup', function (e) {
        if (!start) return;
        var dx = e.clientX - start.x;
        var dy = e.clientY - start.y;
        start = null;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) go(current + (dx < 0 ? 1 : -1));
      });
    }

    /* Sticky buy bar: visible after the buy box scrolls away, until the reviews end. */
    var bar = document.querySelector('[data-buybar]');
    function initBar() {
      if (!bar || typeof ScrollTrigger === 'undefined') return;
      var end = document.getElementById('reviews');
      ScrollTrigger.create({
        trigger: document.getElementById('buy'),
        start: 'bottom top+=80',
        endTrigger: end || 'body',
        end: end ? 'bottom bottom' : 'bottom bottom',
        onToggle: function (self) {
          bar.classList.toggle('is-visible', self.isActive);
          bar.setAttribute('aria-hidden', String(!self.isActive));
          var btn = bar.querySelector('button');
          if (btn) btn.tabIndex = self.isActive ? 0 : -1;
        }
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initBar);
    else initBar();
  })();
</script>

{% stylesheet %}
  /*
    Horizon's base.css styles every label wrapping a radio as inline-flex
    (label:has(input[type="radio"]), specificity 0,1,1), which outranks the reference
    .popt / .pack-opt grid rules. Scope them to the buy box to restore the reference layout.
  */
  .buy .popt {
    display: grid;
    gap: 4px 14px;
    align-items: center;
  }

  .buy .pack-opt {
    display: grid;
    gap: 2px;
    justify-items: start;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product information",
  "tag": "section",
  "class": "section-ellura-main-product",
  "settings": [
    { "type": "text", "id": "crumb_parent", "label": "Breadcrumb parent label", "default": "Shop" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Urinary tract health · Dietary supplement" },
    { "type": "inline_richtext", "id": "title_override", "label": "Title", "info": "Leave empty to use the product title." },
    { "type": "text", "id": "rating", "label": "Average rating", "info": "For example 4.9. Leave empty to hide.", "default": "4.9" },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "78 reviews on our US store" },
    { "type": "richtext", "id": "description", "label": "Short description", "info": "Leave empty to use the product description." },
    { "type": "text", "id": "tax_note", "label": "Tax note", "default": "MRP inclusive of all taxes" },
    { "type": "product_list", "id": "pack_products", "label": "Pack size products", "info": "Other packs to link to from the pack selector.", "limit": 4 },
    { "type": "text", "id": "sub_label", "label": "Subscription option label", "default": "Subscribe & Save 10%" },
    { "type": "checkbox", "id": "default_subscribe", "label": "Preselect Subscribe & Save", "default": true },
    { "type": "text", "id": "notify_text", "label": "Coming soon text", "default": "Its price will be announced at launch — leave your email and we’ll tell you first." },
    { "type": "checkbox", "id": "show_buybar", "label": "Show sticky buy bar", "default": true },
    { "type": "checkbox", "id": "tint_first_image", "label": "Tint first image into the tile", "info": "Blends the pack shot into the coloured gallery tile, like the reference.", "default": true }
  ],

          "default": "pack-30"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image Override"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge pill",
          "default": "1 MONTH"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Pack title",
          "default": "30 capsules"
        },
        {
          "type": "textarea",
          "id": "summary",
          "label": "Summary",
          "default": "One bottle, one capsule a day. The easiest way to start."
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "₹2,199"
        },
        {
          "type": "text",
          "id": "mrp",
          "label": "MRP (strikethrough)",
          "default": "₹2,499"
        },
        {
          "type": "text",
          "id": "subscribe_note",
          "label": "Subscribe note",
          "default": "or ₹1,979 / delivery (Save 10%)"
        },
        {

    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "choose your <em>supply.</em>"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Description",
      "default": "One capsule a day. Pick the bottle that fits your routine — and subscribe to save 10% on every delivery, with free shipping."
    },
    {
      "type": "text",
      "id": "perk_1",
      "label": "Perk 1 text",
      "default": "Subscribe & Save 10%"
    },
    {
      "type": "text",
      "id": "perk_2",
      "label": "Perk 2 text",
      "default": "Free shipping on subscriptions"
    },
    {
      "type": "text",
      "id": "perk_3",
      "label": "Perk 3 text",
      "default": "Pause or cancel anytime"
    },
    {
      "type": "text",
      "id": "compare_link_text",
      "label": "Comparison link label",
      "default": "Compare all packs"
    },
    {
      "type": "url",
      "id": "compare_link_url",
      "label": "Comparison link URL"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "transparent"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "pack",
      "name": "Supply Pack Card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Shopify Product"

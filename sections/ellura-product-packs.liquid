          "default": "blush"
        },
        {
          "type": "text",
          "id": "btn_label",
          "label": "Button label",
          "default": "Shop now"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Pack Cards",
      "blocks": [
        {
          "type": "pack",
          "settings": {
            "preset_image": "pack-30",
            "badge": "1 MONTH",
            "title": "30 capsules",
            "summary": "One bottle, one capsule a day. The easiest way to start.",
            "price": "₹2,199",
            "mrp": "₹2,499",

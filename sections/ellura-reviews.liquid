{% comment %}
  Section contract:
  ellura-reviews renders the customer reviews slider featuring:
  - Big rating score summary card (4.9 stars / 78+ reviews)
  - Horizontal scrollable track with user review cards
  - Share your experience CTA card
  - Interactive rail controls (prev, next, progress bar)
{% endcomment %}

<div
  id="reviews-{{ section.id }}"
  class="hrev section"
  style="--reviews-bg: {{ section.settings.bg_color }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background: var(--reviews-bg);"
  {{ section.shopify_attributes }}
>
  <div class="wrap">
    <div class="section-head">
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow" data-gsap="fade-up">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      <h2 id="reviews-title-{{ section.id }}" class="t-d2 accent-em" data-gsap="fade-up">
        {{ section.settings.heading }}
      </h2>
    </div>

    <!-- Horizontal Review Slider Rail -->
    <div class="rail">
      <ul class="rail__track" id="rail-track-{{ section.id }}" role="list">
        <!-- Card 1: Score Summary Card -->
        <li class="rail__item">
          <article class="hrev__card hrev__card--score">
            <div class="stars" role="img" aria-label="4.9 out of 5 stars">
              {% for i in (1..5) %}
                <span class="stars__star" style="width: 22px; height: 22px;">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="#d0a6d8" stroke="#d0a6d8" stroke-width="1.5"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                </span>
              {% endfor %}
            </div>

            <p class="hrev__big">{{ section.settings.average_score | default: '4.9' }}</p>

            <p>
              average from <strong>{{ section.settings.review_count | default: '78 reviews' }}</strong> on our US store
            </p>

            {% if section.settings.all_reviews_link != blank %}
              <a href="{{ section.settings.all_reviews_link }}" class="text-link">
                {{ section.settings.all_reviews_label | default: 'All reviews' }}
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            {% endif %}
          </article>
        </li>

        <!-- Review Blocks -->
        {% for block in section.blocks %}
          {% if block.type == 'review' %}
            <li class="rail__item" {{ block.shopify_attributes }}>
              <article class="hrev__card hrev__card--{{ block.settings.card_theme }}">
                {% if block.settings.title != blank %}
                  <h3 class="t-h4">{{ block.settings.title | escape }}</h3>
                {% endif %}
                <p class="hrev__quote">“{{ block.settings.body | escape }}”</p>
                <p class="hrev__by">
                  <strong>{{ block.settings.author | escape }}</strong>
                  <span>{{ block.settings.location_or_source | default: 'US store · verbatim' }}</span>
                </p>
              </article>
            </li>
          {% endif %}
        {% endfor %}

        <!-- Card End: Share Experience CTA -->
        <li class="rail__item">
          <article class="hrev__card hrev__card--cta">
            <h3 class="t-d3">
              tried <em>ellura?</em>
            </h3>
            <p>{{ section.settings.cta_body | default: 'India reviews will appear here as verified buyers share them.' }}</p>
            <a href="{{ section.settings.cta_url | default: '/pages/reviews' }}" class="btn btn--white">
              {{ section.settings.cta_btn_label | default: 'Share your experience' }}
            </a>
          </article>
        </li>
      </ul>

      <!-- Controls & Progress -->
      <div class="rail__controls">
        <div class="rail__bar">
          <i id="rail-bar-{{ section.id }}" style="width: 25%;"></i>
        </div>
        <button type="button" class="rail__btn" id="rail-prev-{{ section.id }}" aria-label="Previous review">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        </button>
        <button type="button" class="rail__btn" id="rail-next-{{ section.id }}" aria-label="Next review">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>

    {% if section.settings.disclaimer != blank %}
      <p class="claim hrev__note">{{ section.settings.disclaimer | escape }}</p>
    {% endif %}
  </div>
</div>

<script>
  (function () {
    var track = document.getElementById('rail-track-{{ section.id }}');
    var bar = document.getElementById('rail-bar-{{ section.id }}');
    var prevBtn = document.getElementById('rail-prev-{{ section.id }}');
    var nextBtn = document.getElementById('rail-next-{{ section.id }}');

    if (!track) return;

    function updateProgress() {
      var max = track.scrollWidth - track.clientWidth;
      if (max <= 0) return;
      var pct = Math.max(0.2, (track.scrollLeft / max));
      if (bar) bar.style.width = (pct * 100) + '%';
      if (prevBtn) prevBtn.disabled = track.scrollLeft <= 5;
      if (nextBtn) nextBtn.disabled = track.scrollLeft >= max - 5;
    }

    track.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();

    if (prevBtn) {
      prevBtn.addEventListener('click', function () {
        track.scrollBy({ left: -360, behavior: 'smooth' });
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', function () {
        track.scrollBy({ left: 360, behavior: 'smooth' });
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Customer Reviews Slider",
  "tag": "section",
  "class": "section-ellura-reviews",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Reviews from the US store"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "loved in the US. <em>arriving in India.</em>"
    },
    {
      "type": "text",
      "id": "average_score",
      "label": "Average score",
      "default": "4.9"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review count label",
      "default": "78 reviews"
    },
    {
      "type": "text",
      "id": "all_reviews_label",
      "label": "All reviews link text",
      "default": "All reviews"
    },
    {
      "type": "url",
      "id": "all_reviews_link",
      "label": "All reviews link URL"
    },
    {
      "type": "header",
      "content": "CTA Card"
    },
    {
      "type": "text",
      "id": "cta_body",
      "label": "CTA description",
      "default": "India reviews will appear here as verified buyers share them."
    },
    {
      "type": "text",
      "id": "cta_btn_label",
      "label": "CTA button label",
      "default": "Share your experience"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA button link"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer text",
      "default": "Totals as published on ellurautihealth.com. Individual experiences vary."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background color",
      "default": "transparent"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Customer Review",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Review headline",
          "default": "Great product"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Review body",
          "default": "Great product. I have used it for many years."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Customer name",
          "default": "Janet S."
        },
        {
          "type": "text",
          "id": "location_or_source",
          "label": "Location / Verification note",
          "default": "United States · Verified Buyer"
        },
        {
          "type": "select",
          "id": "card_theme",
          "label": "Card color theme",
          "options": [
            { "value": "blush", "label": "Blush (Soft pink)" },
            { "value": "butter", "label": "Butter (Warm yellow)" },
            { "value": "sage", "label": "Sage (Pale purple)" }
          ],
          "default": "blush"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Reviews Slider",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "title": "Great product",
            "body": "Great product. I have used it for many years.",
            "author": "Janet S.",
            "location_or_source": "United States · Verified Buyer",
            "card_theme": "blush"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "So happy I found this",
            "body": "I’ve been really happy with Ellura! It’s easy to take, and I’ve noticed a positive difference since starting it. Definitely something I’ll continue using!",
            "author": "Savannah",
            "location_or_source": "Verified Buyer",
            "card_theme": "butter"
          }
        },
        {
          "type": "review",
          "settings": {
            "title": "Trusted routine",
            "body": "One capsule daily with my morning water. Clean ingredients, no upset stomach, and completely dependable.",
            "author": "Anonymous",
            "location_or_source": "United States · Verified Buyer",
            "card_theme": "sage"
          }
        }
      ]
    }
  ]
}
{% endschema %}

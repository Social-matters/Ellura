{% comment %}
  Section contract:
  ellura-take-control renders the 36 mg Soluble PACs Take Control Banner
  with large watermark typography, spinning circular badge ring, 4 key clean-label formula cards,
  and dual-tone GSAP animations.
{% endcomment %}

<div
  id="tc-{{ section.id }}"
  class="tc section"
  style="--tc-bg: {{ section.settings.bg_color }}; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; background: var(--tc-bg);"
  {{ section.shopify_attributes }}
>
  <div class="tc__big" aria-hidden="true">{{ section.settings.watermark_num | default: '36' }}</div>

  <svg class="tc__ring" viewBox="0 0 400 400" aria-hidden="true">
    <defs>
      <path id="tcRingPath-{{ section.id }}" d="M200 200 m -170 0 a 170 170 0 1 1 340 0 a 170 170 0 1 1 -340 0" />
    </defs>
    <text>
      <textPath href="#tcRingPath-{{ section.id }}" textLength="1060" lengthAdjust="spacing">
        {{ section.settings.ring_text | default: '36 MG SOLUBLE A-TYPE PACS · 100% CRANBERRY JUICE EXTRACT · CLINICALLY BACKED · ONCE DAILY · ' }}
      </textPath>
    </text>
  </svg>

  <div class="wrap wrap--narrow tc__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow" data-fade>{{ section.settings.eyebrow | escape }}</p>
    {% endif %}

    <h2 id="tc-title-{{ section.id }}" class="t-d2 accent-em" data-split>
      {{ section.settings.heading }}
    </h2>

    {% if section.settings.lead != blank %}
      <p class="t-lead tc__lead" data-fade>{{ section.settings.lead }}</p>
    {% endif %}

    <ul class="tc__attrs" role="list">
      {% for block in section.blocks %}
        {% if block.type == 'attribute' %}
          <li class="tc__attr" {{ block.shopify_attributes }}>
            <span class="tc__icon" style="background: {{ block.settings.icon_bg }};">
              {% case block.settings.icon %}
                {% when 'leaf' %}
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></svg>
                {% when 'wheat' %}
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2 22 10-10M16 8l-2 2M18 6l-2 2M20 4l-2 2M14 10l-2 2M12 12l-2 2M10 14l-2 2M8 16l-2 2M6 18l-2 2M18 10a4 4 0 0 0-4-4M14 14a4 4 0 0 0-4-4M10 18a4 4 0 0 0-4-4"/></svg>
                {% when 'dna' %}
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 15c6.667-6 13.333 0 20-6M9 22c1.798-1.998 2.518-3.995 2.807-5.993M15 2c-1.798 1.998-2.518 3.995-2.807 5.993M17 6l-2.5-2.5M14 8l-1-1M7 18l2.5 2.5M10 16l1 1M2 9c6.667 6 13.333 0 20 6"/></svg>
                {% when 'cube' %}
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m21 16-9 5-9-5V8l9-5 9 5v8zM3.27 6.96 12 12.01l8.73-5.05M12 22.08V12"/></svg>
                {% else %}
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
              {% endcase %}
            </span>
            <strong>{{ block.settings.label | escape }}</strong>
            <span class="muted t-xs">{{ block.settings.note | escape }}</span>
          </li>
        {% endif %}
      {% endfor %}
    </ul>

    {% if section.settings.btn_text != blank %}
      <a href="{{ section.settings.btn_link | default: '/collections/all' }}" class="btn btn--white btn--lg" data-magnetic data-fade>
        {{ section.settings.btn_text | escape }}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    {% endif %}
  </div>
</div>

<script>
  (function () {
    function initTCGSAP() {
      if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') return;
      var root = document.getElementById('tc-{{ section.id }}');
      if (!root) return;

      if (root._tcMM) root._tcMM.revert();
      var mm = gsap.matchMedia();
      root._tcMM = mm;
      mm.add('(prefers-reduced-motion: no-preference)', function () {
        var ring = root.querySelector('.tc__ring');
        if (ring) {
          gsap.to(ring, { rotate: 360, duration: 60, repeat: -1, ease: 'none' });
        }

        var bigNum = root.querySelector('.tc__big');
        if (bigNum) {
          gsap.fromTo(bigNum,
            { yPercent: 18, scale: 0.92 },
            {
              yPercent: -12,
              scale: 1,
              ease: 'none',
              scrollTrigger: { trigger: root, start: 'top bottom', end: 'bottom top', scrub: true }
            }
          );
        }

        var attrs = root.querySelectorAll('.tc__attr');
        if (attrs.length) {
          gsap.fromTo(attrs,
            { y: 40, opacity: 0, rotate: function(i) { return i % 2 ? 6 : -6; } },
            {
              y: 0,
              opacity: 1,
              rotate: 0,
              stagger: 0.1,
              duration: 1,
              ease: 'back.out(1.4)',
              scrollTrigger: { trigger: root.querySelector('.tc__attrs'), start: 'top 85%', once: true }
            }
          );
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initTCGSAP);
    } else {
      initTCGSAP();
    }

    document.addEventListener('shopify:section:load', function (e) {
      if (e.target.id === 'shopify-section-{{ section.id }}') {
        initTCGSAP();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Take Control Banner",
  "tag": "section",
  "class": "section-ellura-take-control",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "36 mg · soluble · bioactive"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "take control of your urinary tract health <em>with ellura</em>"
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Subheading paragraph",
      "default": "ellura contains 36 mg of soluble, bioactive A-type proanthocyanidins (PACs) from 100% pure concentrated cranberry fruit juice (Vaccinium macrocarpon) — a key compound shown in research to help reduce the ability of certain bacteria from adhering to the urinary tract and bladder, supporting urinary tract health."
    },
    {
      "type": "text",
      "id": "watermark_num",
      "label": "Watermark background text",
      "default": "36"
    },
    {
      "type": "text",
      "id": "ring_text",
      "label": "Rotating ring text",
      "default": "36 MG SOLUBLE A-TYPE PACS · 100% CRANBERRY JUICE EXTRACT · CLINICALLY BACKED · ONCE DAILY · "
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Button text",
      "default": "Buy now"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Card background color",
      "default": "#7a3d78"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 40,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 40,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Padding bottom",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "attribute",
      "name": "Formula Attribute",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf (Plant-based / Vegan)" },
            { "value": "wheat", "label": "Wheat (Gluten-free)" },
            { "value": "dna", "label": "DNA (Non-GMO)" },
            { "value": "cube", "label": "Cube (Sugar-free)" }
          ],
          "default": "leaf"
        },
        {
          "type": "color",
          "id": "icon_bg",
          "label": "Icon circle background",
          "default": "#e3cbe8"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Attribute title",
          "default": "Vegan"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Attribute subtext",
          "default": "100% plant-based capsule"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Take Control Banner",
      "blocks": [
        { "type": "attribute", "settings": { "icon": "leaf", "icon_bg": "#e3cbe8", "label": "Vegan", "note": "100% plant-based capsule" } },
        { "type": "attribute", "settings": { "icon": "wheat", "icon_bg": "#ead3ee", "label": "Gluten-free", "note": "No gluten, wheat or lactose" } },
        { "type": "attribute", "settings": { "icon": "dna", "icon_bg": "#deC0e4", "label": "Non-GMO", "note": "No GMOs, dyes or artificial preservatives" } },
        { "type": "attribute", "settings": { "icon": "cube", "icon_bg": "#f4e8f6", "label": "Sugar-free", "note": "No added sugars or sweeteners" } }
      ]
    }
  ]
}
{% endschema %}

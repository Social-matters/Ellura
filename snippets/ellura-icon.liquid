{% doc %}
  Renders a stroked line icon from the ellura icon set (24px grid, currentColor).
  Icons are decorative: the SVG is aria-hidden, so pair it with visible or sr-only text.

  @param {string} name - Icon name, e.g. 'arrow', 'check', 'truck', 'capsule'
  @param {number} [px] - Rendered width and height in px (default 24)
  @param {string} [class] - Extra class names for the svg

  @example
  {% render 'ellura-icon', name: 'arrow', px: 18 %}
{% enddoc %}
{%- liquid
  assign icon_size = px | default: 24
  case name
    when 'arrow'
      assign icon_paths = '<path d="M4 12h15m-6-6 6 6-6 6"/>'
    when 'arrowLeft'
      assign icon_paths = '<path d="M20 12H5m6-6-6 6 6 6"/>'
    when 'arrowUpRight'
      assign icon_paths = '<path d="M7 17 17 7M9 7h8v8"/>'
    when 'chevron'
      assign icon_paths = '<path d="m6 9 6 6 6-6"/>'
    when 'chevronRight'
      assign icon_paths = '<path d="m9 6 6 6-6 6"/>'
    when 'chevronLeft'
      assign icon_paths = '<path d="m15 6-6 6 6 6"/>'
    when 'plus'
      assign icon_paths = '<path d="M12 5v14M5 12h14"/>'
    when 'minus'
      assign icon_paths = '<path d="M5 12h14"/>'
    when 'close'
      assign icon_paths = '<path d="M6 6l12 12M18 6 6 18"/>'
    when 'check'
      assign icon_paths = '<path d="m5 12.5 4.5 4.5L19 7.5"/>'
    when 'menu'
      assign icon_paths = '<path d="M3.5 8h17M3.5 16h17"/>'
    when 'search'
      assign icon_paths = '<circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/>'
    when 'bag'
      assign icon_paths = '<path d="M5 8h14l-1.1 11.2a1 1 0 0 1-1 .8H7.1a1 1 0 0 1-1-.8L5 8Z"/><path d="M9 10V7a3 3 0 0 1 6 0v3"/>'
    when 'user'
      assign icon_paths = '<circle cx="12" cy="8.5" r="3.8"/><path d="M4.5 20c1.3-3.6 4.2-5.4 7.5-5.4s6.2 1.8 7.5 5.4"/>'
    when 'star'
      assign icon_paths = '<path d="m12 3.6 2.5 5.3 5.8.7-4.3 4 1.1 5.8L12 16.6l-5.1 2.8L8 13.6l-4.3-4 5.8-.7L12 3.6Z"/>'
    when 'truck'
      assign icon_paths = '<path d="M3 6.5h11v9H3zM14 9.5h3.8l3 3.2v2.8H14"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/>'
    when 'repeat'
      assign icon_paths = '<path d="M4 11V9.5A3.5 3.5 0 0 1 7.5 6H19m-3-3 3 3-3 3"/><path d="M20 13v1.5a3.5 3.5 0 0 1-3.5 3.5H5m3 3-3-3 3-3"/>'
    when 'pause'
      assign icon_paths = '<path d="M9 6v12M15 6v12"/>'
    when 'shield'
      assign icon_paths = '<path d="M12 3.5 5 6v5.5c0 4.3 2.9 7.7 7 9 4.1-1.3 7-4.7 7-9V6l-7-2.5Z"/><path d="m9 12 2.2 2.2L15.5 10"/>'
    when 'capsule'
      assign icon_paths = '<rect x="3.2" y="8.6" width="17.6" height="6.8" rx="3.4" transform="rotate(-35 12 12)"/><path d="m10.2 9.4 3.9 5.4"/>'
    when 'drop'
      assign icon_paths = '<path d="M12 3.5s6 6.4 6 10.5a6 6 0 0 1-12 0c0-4.1 6-10.5 6-10.5Z"/>'
    when 'leaf'
      assign icon_paths = '<path d="M5 19c0-8 5-13 14-14 0 9-5 14-13 14"/><path d="M5 19c3-4 6-6.5 9.5-8.5"/>'
    when 'wheat'
      assign icon_paths = '<path d="M12 21V8"/><path d="M12 12c-2.5 0-4-1.6-4-4 2.5 0 4 1.6 4 4Zm0 0c2.5 0 4-1.6 4-4-2.5 0-4 1.6-4 4Zm0 4c-2.5 0-4-1.6-4-4 2.5 0 4 1.6 4 4Zm0 0c2.5 0 4-1.6 4-4-2.5 0-4 1.6-4 4ZM12 8c-1.2-1-1.2-3 0-4.5 1.2 1.5 1.2 3.5 0 4.5Z"/><path d="M4 4l16 16"/>'
    when 'dna'
      assign icon_paths = '<path d="M8 3c0 5 8 5 8 9s-8 4-8 9M16 3c0 5-8 5-8 9s8 4 8 9"/><path d="M9.5 6.5h5M9.5 17.5h5M4 4l16 16"/>'
    when 'cube'
      assign icon_paths = '<path d="M12 3.5 19.5 7.5v9L12 20.5 4.5 16.5v-9L12 3.5Z"/><path d="M4.5 7.5 12 11.5l7.5-4M12 11.5v9M4 4l16 16"/>'
    when 'mail'
      assign icon_paths = '<rect x="3.5" y="5.5" width="17" height="13" rx="1.5"/><path d="m4 7 8 6 8-6"/>'
    when 'phone'
      assign icon_paths = '<path d="M6.5 3.5h3l1.5 4-2 1.3a10 10 0 0 0 6.2 6.2l1.3-2 4 1.5v3a2 2 0 0 1-2 2A16.5 16.5 0 0 1 4.5 5.5a2 2 0 0 1 2-2Z"/>'
    when 'chat'
      assign icon_paths = '<path d="M4 5.5h16v10H9.5L5.5 19v-3.5H4z"/>'
    when 'lock'
      assign icon_paths = '<rect x="5" y="10.5" width="14" height="10" rx="1.5"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/>'
    when 'info'
      assign icon_paths = '<circle cx="12" cy="12" r="8.5"/><path d="M12 11v5.5M12 7.6v.2"/>'
    when 'trash'
      assign icon_paths = '<path d="M5 7h14M10 7V4.5h4V7M7 7l1 13h8l1-13"/>'
    when 'filter'
      assign icon_paths = '<path d="M4 6h16M7 12h10M10 18h4"/>'
    when 'sort'
      assign icon_paths = '<path d="M8 4v16m0 0-3-3m3 3 3-3M16 20V4m0 0-3 3m3-3 3 3"/>'
    when 'play'
      assign icon_paths = '<path d="M8 5.5v13l10.5-6.5L8 5.5Z"/>'
    when 'gift'
      assign icon_paths = '<rect x="4" y="9" width="16" height="11" rx="1"/><path d="M3.5 9h17M12 9v11M12 9c-1.5-3.5-6-3.5-5 0M12 9c1.5-3.5 6-3.5 5 0"/>'
    when 'pin'
      assign icon_paths = '<path d="M12 21s6.5-6.1 6.5-11a6.5 6.5 0 0 0-13 0c0 4.9 6.5 11 6.5 11Z"/><circle cx="12" cy="10" r="2.3"/>'
    when 'box'
      assign icon_paths = '<path d="M3.5 7.5 12 3.5l8.5 4v9L12 20.5l-8.5-4v-9Z"/><path d="M3.5 7.5 12 11.5l8.5-4M12 11.5v9"/>'
    when 'flask'
      assign icon_paths = '<path d="M9.5 3.5h5M10.5 3.5v6L5 18.5a1.5 1.5 0 0 0 1.3 2h11.4a1.5 1.5 0 0 0 1.3-2l-5.5-9v-6"/><path d="M7.5 14.5h9"/>'
    when 'store'
      assign icon_paths = '<path d="M4 9.5 5.5 4.5h13L20 9.5M4 9.5h16M4 9.5v10h16v-10"/><path d="M9.5 19.5v-5h5v5"/>'
    when 'bolt'
      assign icon_paths = '<path d="M13 3.5 5.5 13.5H12l-1 7 7.5-10H12l1-7Z"/>'
    else
      assign icon_paths = ''
  endcase
-%}
{%- if icon_paths != blank -%}
<svg class="icon-svg {{ class }}" width="{{ icon_size }}" height="{{ icon_size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">{{ icon_paths }}</svg>
{%- endif -%}

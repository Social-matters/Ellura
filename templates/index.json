    "ellura_faq": {
      "type": "ellura-faq",
      "blocks": {
        "ellura_faq_block_1": {
          "type": "question",
          "settings": {
            "question": "What is ellura?",
            "answer": "<p>ellura is a clinically backed supplement that supports urinary tract health and helps reduce the ability of certain bacteria to adhere to the urinary tract, allowing them to be flushed out naturally.</p>"
          }
        },
        "ellura_faq_block_2": {
          "type": "question",
          "settings": {
            "question": "What are the ingredients in ellura?",
            "answer": "<p>Each capsule delivers 36 mg of soluble, bioactive proanthocyanidins (PACs) from 206 mg of concentrated cranberry fruit juice extract powder (Gikacran®), the key clinically studied compound.</p><p>Clean vegetarian capsule shell with no GMOs, gluten, added sugars, or artificial dyes.</p>"
          }
        },
        "ellura_faq_block_3": {
          "type": "question",
          "settings": {
            "question": "How do I take ellura?",
            "answer": "<p>Take 1 capsule once daily with water, at the same time each day. For extra support during travel or stress, you can take two capsules, then return to one.</p>"
          }
        },
        "ellura_faq_block_4": {
          "type": "question",
          "settings": {
            "question": "How is ellura different from cranberry juice or pills?",
            "answer": "<p>Unlike generic cranberry pills made from leftover pomace (stems and seeds), ellura is derived exclusively from 100% concentrated cranberry fruit juice, delivering soluble, bioavailable PACs that your body can actually absorb.</p>"
          }
        }
      },

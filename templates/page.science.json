    "glossary": {
      "type": "ellura-glossary",
      "blocks": {
        "ellura_glossary_01": {
          "type": "term",
          "settings": {
            "term": "Proanthocyanidins (PACs)",
            "definition": "Naturally occurring polyphenol compounds in cranberry fruit. A-type PACs are the form studied for urinary anti-adhesion activity."
          }
        },
        "ellura_glossary_02": {
          "type": "term",
          "settings": {
            "term": "A-type PACs",
            "definition": "PACs with a particular double linkage between units, characteristic of North American cranberries (Vaccinium macrocarpon)."
          }
        },
        "ellura_glossary_03": {
          "type": "term",
          "settings": {
            "term": "Soluble PACs",
            "definition": "PACs found in the juice portion of the cranberry, free to be absorbed. ellura uses only concentrated cranberry fruit juice extract."
          }
        },
        "ellura_glossary_04": {
          "type": "term",
          "settings": {
            "term": "Insoluble PACs / pomace",
            "definition": "PACs that stay bound to the fibre in pomace (press cake) — the seeds, stems, skin and pulp left after juicing."
          }
        },
        "ellura_glossary_05": {
          "type": "term",
          "settings": {
            "term": "Anti-adhesion activity (AAA)",
            "definition": "A laboratory measure of how well urine samples reduce the ability of bacteria to stick to cells."
          }
        },
        "ellura_glossary_06": {
          "type": "term",
          "settings": {
            "term": "DMAC/A2 method",
            "definition": "A validated laboratory method (4-dimethylaminocinnamaldehyde with an A2 reference standard) used to measure soluble PAC content."
          }
        },
        "ellura_glossary_07": {
          "type": "term",
          "settings": {
            "term": "Gikacran®",
            "definition": "Pharmatoka’s proprietary concentrated cranberry fruit juice extract. Each ellura capsule contains 206 mg, delivering 36 mg PACs."
          }
        },
        "ellura_glossary_08": {
          "type": "term",
          "settings": {
            "term": "Pili (fimbriae)",
            "definition": "Tiny hair-like structures — Type 1 and P-type — that E. coli use to attach to the urinary tract lining."
          }
        }
      },
